    {"provider":"Meta","model_family":"MusicGen","reason":"cc_by_nc_weight_scope"},
    {"provider":"Tencent AI Lab","model_family":"SongGeneration 2","reason":"authoritative_license_unverified"},
    {"provider":"Stability AI","model_family":"Stable Audio Open","reason":"community_license_and_competitive_use_scope"},
    {"provider":"M-A-P","model_family":"YuE and YuE2","reason":"checkpoint_generation_license_variance"}
  ],
  "reconsideration_policy": "explicit_owner_approval_with_current_license_snapshot/v1"
