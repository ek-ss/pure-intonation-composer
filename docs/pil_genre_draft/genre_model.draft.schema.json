{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/draft-schemas/pil_genre_model.draft.schema.json",
  "title": "CPS PIL GenreModel 1.0 (DRAFT, non-normative)",
  "description": "Design draft for contract section 7 blocker G1. This file is NOT a contract schema and MUST NOT be copied into backend/songprogram_conformance/schemas/ except by the owner through the authoritative-update workflow. Shape follows docs/song_program_pil_genre_interpretation_draft.md section 3.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "algorithm",
    "model_schema_hash",
    "feature_spec_hash",
    "vocabulary_hash",
    "trajectory_template_set_hash",
    "required_groups",
    "entries",
    "model_hash"
  ],
  "properties": {
    "schema": {"const": "cps.perceptual-genre-model"},
    "schema_version": {"const": "1.0.0"},
    "algorithm": {
      "const": "pil-genre-prototype-l1/v1",
      "description": "Proposed algorithm identity; the score formulas themselves are open decision G3."
    },
    "model_schema_hash": {"$ref": "#/$defs/sha"},
    "feature_spec_hash": {"$ref": "#/$defs/sha"},
    "vocabulary_hash": {"$ref": "#/$defs/sha"},
    "trajectory_template_set_hash": {"$ref": "#/$defs/sha"},
    "required_groups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/group"},
      "description": "Minimum executable closure. Harmony-only is the proposed 1.0 minimum (open decision G5)."
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/entry"}
    },
    "model_hash": {
      "$ref": "#/$defs/sha",
      "description": "Generic cps-artifact-hash/v1 self hash over the canonical body without this field."
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "group": {
      "enum": ["harmony", "melody", "rhythm", "form", "instrumentation", "production"]
    },
    "q": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "q31_weight": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647,
      "description": "Sparse Q31 weight; per-target-family weights of one entry sum to 2^31 (checked by tooling, not by schema)."
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "genre_id",
        "ordinal",
        "chord_vocabulary_targets",
        "progression_targets",
        "function_profile_q",
        "voice_leading_profile_q",
        "harmonic_rhythm_profile_q"
      ],
      "properties": {
        "genre_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63,
          "description": "Unique, contiguous, stored order; used as the final tie-break key for report row ordering."
        },
        "chord_vocabulary_targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/vocabulary_target"}
        },
        "progression_targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/template_target"}
        },
        "function_profile_q": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/q"}
        },
        "voice_leading_profile_q": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/q"}
        },
        "harmonic_rhythm_profile_q": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/q"}
        }
      }
    },
    "vocabulary_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vocabulary_ordinal", "weight_q31"],
      "properties": {
        "vocabulary_ordinal": {"type": "integer", "minimum": 0},
        "weight_q31": {"$ref": "#/$defs/q31_weight"}
      }
    },
    "template_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_ordinal", "weight_q31"],
      "properties": {
        "template_ordinal": {"type": "integer", "minimum": 0},
        "weight_q31": {"$ref": "#/$defs/q31_weight"}
      }
    }
  }
}
