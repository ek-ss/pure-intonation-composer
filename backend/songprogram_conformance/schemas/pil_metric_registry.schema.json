{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/pil_metric_registry.schema.json","title":"PIL Metric Registry v1","type":"object","additionalProperties":false,"required":["schema","schema_version","scope","metrics","registry_hash"],"properties":{"schema":{"const":"cps.pil-metric-registry"},"schema_version":{"const":"1.0.0"},"scope":{"const":"phase_1_4"},"metrics":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/metric"}},"registry_hash":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"metric":{"type":"object","additionalProperties":false,"required":["metric_id","source_selector","aggregation","direction","missing_policy"],"properties":{"metric_id":{"type":"string","pattern":"^pil\\.[a-z][a-z0-9_.]{0,59}$"},"source_selector":{"type":"string","pattern":"^/[^ ]+$"},"aggregation":{"enum":["minimum","maximum","minimum-runner-up-margin","maximum-absolute"]},"direction":{"enum":["maximize","minimize"]},"missing_policy":{"const":"unavailable"}}}}}
