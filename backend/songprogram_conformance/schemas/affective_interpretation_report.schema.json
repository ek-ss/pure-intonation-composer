{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/affective_interpretation_report.schema.json",
  "title":"AffectiveInterpretationReport 1.0","type":"object","additionalProperties":false,
  "required":["schema","schema_version","project_hash","manifest_hash","implementation_build_id","status","whole_song","sections","audio_feature_status","error","report_hash"],
  "properties":{
    "schema":{"const":"cps.affective-interpretation-report"},"schema_version":{"const":"1.0.0"},
    "project_hash":{"$ref":"#/$defs/sha"},"manifest_hash":{"$ref":"#/$defs/sha"},
    "implementation_build_id":{"type":"string","minLength":1,"maxLength":128},"status":{"const":"success"},
    "whole_song":{"$ref":"#/$defs/metrics"},
    "sections":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["section_id","start_tick","end_tick","metrics"],"properties":{"section_id":{"type":"string","minLength":1},"start_tick":{"type":"integer","minimum":0},"end_tick":{"type":"integer","minimum":1},"metrics":{"$ref":"#/$defs/metrics"}}}},
    "audio_feature_status":{"const":"not_evaluated"},"error":{"type":"null"},"report_hash":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"signed_q":{"type":"integer","minimum":-10000,"maximum":10000},"q":{"type":"integer","minimum":0,"maximum":10000},
    "metrics":{"type":"object","additionalProperties":false,"required":["perceived_valence_q","arousal_q","harmonic_majorness_q","tonal_tension_q","timbral_brightness_q","confidence_q"],"properties":{"perceived_valence_q":{"$ref":"#/$defs/signed_q"},"arousal_q":{"$ref":"#/$defs/q"},"harmonic_majorness_q":{"$ref":"#/$defs/signed_q"},"tonal_tension_q":{"$ref":"#/$defs/q"},"timbral_brightness_q":{"type":"null"},"confidence_q":{"$ref":"#/$defs/q"}}}
  }
}
