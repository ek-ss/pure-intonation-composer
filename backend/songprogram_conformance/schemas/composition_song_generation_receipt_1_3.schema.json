{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/composition_song_generation_receipt_1_3.schema.json",
  "title": "Composition Song Generation Receipt 1.3",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "seed", "piano_style", "structural_seed", "structural_rejection_ordinal", "profile_hash", "realization_profile_hash", "plan_hash", "program_hash", "project_hash", "wav_hash", "midi_hash", "midi_manifest_hash", "song_validity_hash", "g1_feature_report_hash", "archive_eligible", "artifact_names", "non_authoritative"],
  "properties": {
    "schema": {"const": "cps.composition-song-generation-receipt"},
    "schema_version": {"const": "1.3.0"},
    "piano_style": {"enum": ["ostinato", "obbligato", "mixed"]},
    "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "structural_seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "structural_rejection_ordinal": {"type": "integer", "minimum": 0, "maximum": 63},
    "profile_hash": {"$ref": "#/$defs/sha256"}, "plan_hash": {"$ref": "#/$defs/sha256"},
    "realization_profile_hash": {"$ref": "#/$defs/sha256"},
    "program_hash": {"$ref": "#/$defs/sha256"}, "project_hash": {"$ref": "#/$defs/sha256"},
    "wav_hash": {"$ref": "#/$defs/sha256"},
    "midi_hash": {"$ref": "#/$defs/sha256"},
    "midi_manifest_hash": {"$ref": "#/$defs/sha256"},
    "song_validity_hash": {"$ref": "#/$defs/sha256"}, "archive_eligible": {"type": "boolean"},
    "g1_feature_report_hash": {"$ref": "#/$defs/sha256"},
    "artifact_names": {"const": ["composition_plan.json", "evaluation_reference.mid", "evaluation_reference_midi.json", "g1_features.json", "perceptual_preview.wav", "program.json", "project.json", "reference.wav", "song_validity.json", "structural_program.json"]},
    "non_authoritative": {"const": true}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
