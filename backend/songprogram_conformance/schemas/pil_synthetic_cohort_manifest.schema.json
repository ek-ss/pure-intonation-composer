{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_cohort_manifest.schema.json",
  "title": "PIL Synthetic LLM Cohort Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_kind",
    "human_authority_compatible",
    "human_listener_evidence",
    "authority_effect",
    "cohort_id",
    "protocol_hash",
    "agent_manifest_hashes",
    "agent_count",
    "manifest_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.pil-synthetic-cohort-manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority_kind": {
      "const": "synthetic_llm"
    },
    "human_authority_compatible": {
      "const": false
    },
    "human_listener_evidence": {
      "const": false
    },
    "authority_effect": {
      "const": "audit_only"
    },
    "cohort_id": {
      "$ref": "#/$defs/id"
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha"
    },
    "agent_manifest_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha"
      }
    },
    "agent_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
    }
  }
}
