{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/broad_prior_production_result.schema.json",
  "title": "CPS BroadPriorProductionResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "request_hash",
    "lowering_manifest_hash",
    "structural_program_hash",
    "rejections_consumed",
    "role_decisions",
    "decision_trace",
    "output",
    "error",
    "result_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.broad-prior-production-result"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "success",
        "failure"
      ]
    },
    "request_hash": {
      "$ref": "#/$defs/sha"
    },
    "lowering_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "structural_program_hash": {
      "$ref": "#/$defs/sha"
    },
    "rejections_consumed": {
      "$ref": "#/$defs/u64"
    },
    "role_decisions": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/roleDecision"
      }
    },
    "decision_trace": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trace"
      }
    },
    "output": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/output"
        }
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "SAMPLER_PRODUCTION_MANIFEST_INVALID",
        "SAMPLER_CATALOG_MISMATCH",
        "SAMPLER_ACTIVE_ROLE_INVALID",
        "SAMPLER_PRODUCTION_PROFILE_UNAVAILABLE",
        "SAMPLER_NO_COMPATIBLE_INSTRUMENT",
        "SAMPLER_NO_COMPATIBLE_REGISTER",
        "SAMPLER_NO_COMPATIBLE_POLYPHONY",
        "SAMPLER_DRUM_MAP_INVALID",
        "SAMPLER_PRODUCTION_VALUE_INVALID",
        "SAMPLER_RESULT_INVALID"
      ]
    },
    "result_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "roleDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "instrument_id",
        "register_millicents",
        "maximum_polyphony",
        "drum_map_id",
        "drum_map",
        "drum_map_payload_hash",
        "gain_q",
        "pan_q"
      ],
      "properties": {
        "role": {
          "enum": [
            "drums",
            "bass",
            "harmony",
            "melody",
            "texture"
          ]
        },
        "instrument_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "register_millicents": {
          "type": [
            "array",
            "null"
          ],
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "items": false
        },
        "maximum_polyphony": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "drum_map_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 80
        },
        "drum_map": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 128,
              "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,79}$"
              },
              "additionalProperties": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              }
            }
          ]
        },
        "drum_map_payload_hash": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sha"
            }
          ]
        },
        "gain_q": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "pan_q": {
          "type": "integer",
          "minimum": -10000,
          "maximum": 10000
        }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "production_rejection_ordinal",
        "role",
        "field",
        "counter",
        "path_hash",
        "eligible_table_hash",
        "selected_value_hash"
      ],
      "properties": {
        "production_rejection_ordinal": {
          "$ref": "#/$defs/u64"
        },
        "role": {
          "enum": [
            "global",
            "drums",
            "bass",
            "harmony",
            "melody",
            "texture"
          ]
        },
        "field": {
          "enum": [
            "profile",
            "instrument",
            "register",
            "maximum_polyphony",
            "drum_map",
            "gain_q",
            "pan_q"
          ]
        },
        "counter": {
          "const": 0
        },
        "path_hash": {
          "$ref": "#/$defs/sha"
        },
        "eligible_table_hash": {
          "$ref": "#/$defs/sha"
        },
        "selected_value_hash": {
          "$ref": "#/$defs/sha"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_payload_hash",
        "catalog_digest",
        "program",
        "program_hash"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "profile_payload_hash": {
          "$ref": "#/$defs/sha"
        },
        "catalog_digest": {
          "$ref": "#/$defs/sha"
        },
        "program": {
          "$ref": "song_program_0_1.schema.json"
        },
        "program_hash": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
