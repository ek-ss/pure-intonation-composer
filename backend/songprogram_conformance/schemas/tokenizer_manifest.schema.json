{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/tokenizer_manifest.schema.json","title":"TokenizerManifest v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","algorithm","implementation_asset","vocabulary_asset","merges_asset","normalization_asset","special_tokens","counting","manifest_hash"],
  "properties":{"schema":{"const":"cps.tokenizer-manifest"},"schema_version":{"const":"1.0.0"},"algorithm":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]{0,127}$"},"implementation_asset":{"$ref":"#/$defs/asset"},"vocabulary_asset":{"$ref":"#/$defs/asset"},"merges_asset":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/asset"}]},"normalization_asset":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/asset"}]},"special_tokens":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/token"}},"counting":{"const":"assembled-request-token-count/v1"},"manifest_hash":{"$ref":"#/$defs/sha"}},
  "$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"asset":{"type":"object","additionalProperties":false,"required":["content_kind","raw_bytes_hash","byte_length"],"properties":{"content_kind":{"enum":["executable","vocabulary","merges","normalization"]},"raw_bytes_hash":{"$ref":"#/$defs/sha"},"byte_length":{"type":"integer","minimum":0,"maximum":1073741824}}},"token":{"type":"object","additionalProperties":false,"required":["id","utf8","bytes_hash","counted"],"properties":{"id":{"type":"integer","minimum":0,"maximum":4294967295},"utf8":{"type":"string","maxLength":1024},"bytes_hash":{"$ref":"#/$defs/sha"},"counted":{"type":"boolean"}}}}
}
