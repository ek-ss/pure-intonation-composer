{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/composition_generation_profile_2_0.schema.json",
  "title": "CPS Composition Generation Profile 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "generator", "choice_algorithm", "form_templates", "phrase_policy", "harmonic_trajectory_policy", "motif_policy", "part_coordination_policy", "profile_hash"],
  "properties": {
    "schema": {"const": "cps.composition-generation-profile"},
    "schema_version": {"const": "2.0.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "generator": {"const": "ordered-form-phrase/v1"},
    "choice_algorithm": {"const": "seed-domain-sha256-weighted/v1"},
    "profile_hash": {"$ref": "#/$defs/sha256"},
    "form_templates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["template_id", "weight", "sections"],
        "properties": {
          "template_id": {"type": "string", "minLength": 1},
          "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647},
          "sections": {"type": "array", "minItems": 3, "maxItems": 8, "items": {"$ref": "#/$defs/section"}}
        }
      }
    },
    "phrase_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "length_choices_by_function", "slots_by_length_bars"],
      "properties": {
        "algorithm": {"const": "ordered-exact-section-partition/v1"},
        "length_choices_by_function": {"$ref": "#/$defs/functionLengthMap"},
        "slots_by_length_bars": {
          "type": "object", "minProperties": 1, "additionalProperties": false,
          "patternProperties": {"^[2-8]$": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/phraseSlot"}}}
        }
      }
    },
    "harmonic_trajectory_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "home_state_id", "states", "eligible_state_ids_by_section_function", "terminal_state_ids_by_cadence_target", "transitions"],
      "properties": {
        "algorithm": {"const": "seeded-function-constrained-state-path/v1"},
        "home_state_id": {"type": "string", "minLength": 1},
        "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/harmonicState"}},
        "eligible_state_ids_by_section_function": {"$ref": "#/$defs/functionStateMap"},
        "terminal_state_ids_by_cadence_target": {"$ref": "#/$defs/cadenceStateMap"},
        "transitions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/harmonicTransition"}}
      }
    },
    "motif_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "templates", "operation_choices_by_foreground_state", "rhythmic_displacement_q_choices"],
      "properties": {
        "algorithm": {"const": "seeded-normalized-motif-lineage/v1"},
        "templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/motifTemplate"}},
        "operation_choices_by_foreground_state": {"$ref": "#/$defs/foregroundOperationMap"},
        "rhythmic_displacement_q_choices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 4999}}
      }
    },
    "part_coordination_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "drum_onsets_q", "bass_onsets_q", "drum_duration_q", "bass_duration_q", "boundary_gesture_onset_q", "melody_chord_member_cycle"],
      "properties": {
        "algorithm": {"const": "kick-bass-harmony-foreground/v1"},
        "drum_onsets_q": {"$ref": "#/$defs/normalizedOnsets"},
        "bass_onsets_q": {"$ref": "#/$defs/normalizedOnsets"},
        "drum_duration_q": {"type": "integer", "minimum": 1, "maximum": 10000},
        "bass_duration_q": {"type": "integer", "minimum": 1, "maximum": 10000},
        "boundary_gesture_onset_q": {"type": "integer", "minimum": 0, "maximum": 9999},
        "melody_chord_member_cycle": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 7}}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "sectionFunction": {"enum": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"]},
    "cadenceTarget": {"enum": ["none", "continuation", "arrival", "home", "open"]},
    "foregroundState": {"enum": ["absent", "introduce", "present", "develop", "recall", "release"]},
    "phraseSlot": {"enum": ["pickup", "body", "answer", "cadence"]},
    "normalizedOnsets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 9999}},
    "stateIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "harmonicState": {"type": "object", "additionalProperties": false, "required": ["state_id", "harmonic_function", "root_degree_ordinal"], "properties": {"state_id": {"type": "string", "minLength": 1}, "harmonic_function": {"enum": ["home", "departure", "preparation", "arrival", "return"]}, "root_degree_ordinal": {"type": "integer", "minimum": -64, "maximum": 64}}},
    "harmonicTransition": {"type": "object", "additionalProperties": false, "required": ["from_state_id", "to_state_id", "weight"], "properties": {"from_state_id": {"type": "string", "minLength": 1}, "to_state_id": {"type": "string", "minLength": 1}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "motifEvent": {"type": "object", "additionalProperties": false, "required": ["position_q", "duration_q", "degree_delta"], "properties": {"position_q": {"type": "integer", "minimum": 0, "maximum": 9999}, "duration_q": {"type": "integer", "minimum": 1, "maximum": 10000}, "degree_delta": {"type": "integer", "minimum": -64, "maximum": 64}}},
    "motifTemplate": {"type": "object", "additionalProperties": false, "required": ["template_id", "weight", "events"], "properties": {"template_id": {"type": "string", "minLength": 1}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}, "events": {"type": "array", "minItems": 2, "maxItems": 16, "items": {"$ref": "#/$defs/motifEvent"}}}},
    "weightedOperation": {"type": "object", "additionalProperties": false, "required": ["operation", "weight"], "properties": {"operation": {"enum": ["rest", "statement", "recall", "answer", "rhythmic_displacement", "fragmentation", "cadential_release"]}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "weightedOperations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/weightedOperation"}},
    "foregroundOperationMap": {"type": "object", "additionalProperties": false, "required": ["absent", "introduce", "present", "develop", "recall", "release"], "properties": {"absent": {"$ref": "#/$defs/weightedOperations"}, "introduce": {"$ref": "#/$defs/weightedOperations"}, "present": {"$ref": "#/$defs/weightedOperations"}, "develop": {"$ref": "#/$defs/weightedOperations"}, "recall": {"$ref": "#/$defs/weightedOperations"}, "release": {"$ref": "#/$defs/weightedOperations"}}},
    "functionStateMap": {"type": "object", "additionalProperties": false, "required": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"], "properties": {"opening": {"$ref": "#/$defs/stateIds"}, "statement": {"$ref": "#/$defs/stateIds"}, "preparation": {"$ref": "#/$defs/stateIds"}, "arrival": {"$ref": "#/$defs/stateIds"}, "contrast": {"$ref": "#/$defs/stateIds"}, "return": {"$ref": "#/$defs/stateIds"}, "closure": {"$ref": "#/$defs/stateIds"}}},
    "cadenceStateMap": {"type": "object", "additionalProperties": false, "required": ["none", "continuation", "arrival", "home", "open"], "properties": {"none": {"$ref": "#/$defs/stateIds"}, "continuation": {"$ref": "#/$defs/stateIds"}, "arrival": {"$ref": "#/$defs/stateIds"}, "home": {"$ref": "#/$defs/stateIds"}, "open": {"$ref": "#/$defs/stateIds"}}},
    "section": {
      "type": "object", "additionalProperties": false,
      "required": ["section_key", "function", "bars", "energy_q", "density_q", "cadence_target", "foreground_state"],
      "properties": {
        "section_key": {"type": "string", "minLength": 1},
        "function": {"$ref": "#/$defs/sectionFunction"},
        "bars": {"type": "integer", "minimum": 2, "maximum": 16},
        "energy_q": {"type": "integer", "minimum": 0, "maximum": 10000},
        "density_q": {"type": "integer", "minimum": 0, "maximum": 10000},
        "cadence_target": {"$ref": "#/$defs/cadenceTarget"},
        "foreground_state": {"$ref": "#/$defs/foregroundState"}
      }
    },
    "weightedLength": {
      "type": "object", "additionalProperties": false,
      "required": ["length_bars", "weight"],
      "properties": {"length_bars": {"type": "integer", "minimum": 2, "maximum": 8}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}}
    },
    "weightedLengths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/weightedLength"}},
    "functionLengthMap": {
      "type": "object", "additionalProperties": false,
      "required": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"],
      "properties": {
        "opening": {"$ref": "#/$defs/weightedLengths"}, "statement": {"$ref": "#/$defs/weightedLengths"},
        "preparation": {"$ref": "#/$defs/weightedLengths"}, "arrival": {"$ref": "#/$defs/weightedLengths"},
        "contrast": {"$ref": "#/$defs/weightedLengths"}, "return": {"$ref": "#/$defs/weightedLengths"},
        "closure": {"$ref": "#/$defs/weightedLengths"}
      }
    }
  }
}
