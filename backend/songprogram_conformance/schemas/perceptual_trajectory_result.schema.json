{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/perceptual_trajectory_result.schema.json","title":"PIL TrajectoryInterpretation v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","match_id","template_set_hash","template_id","template_ordinal","start_segment_ordinal","segment_ids","transition_record_hashes","component_scores_q","similarity_q","canonical_alignment_key","result_hash"],
  "properties":{
    "schema":{"const":"cps.perceptual-trajectory-interpretation"},"schema_version":{"const":"1.0.0"},"match_id":{"type":"string","pattern":"^tjm_[0-9a-f]{32}$"},"template_set_hash":{"$ref":"#/$defs/sha"},"template_id":{"type":"string"},"template_ordinal":{"type":"integer","minimum":0,"maximum":255},"start_segment_ordinal":{"type":"integer","minimum":0,"maximum":4095},"segment_ids":{"type":"array","minItems":2,"maxItems":16,"items":{"type":"string","pattern":"^seg_[0-9a-f]{32}$"}},"transition_record_hashes":{"type":"array","minItems":1,"maxItems":15,"items":{"$ref":"#/$defs/sha"}},
    "component_scores_q":{"type":"object","additionalProperties":false,"required":["chord","bass","common_tone","contrary_motion","resolution","tension","metrical"],"properties":{"chord":{"$ref":"#/$defs/q"},"bass":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/q"}]},"common_tone":{"$ref":"#/$defs/q"},"contrary_motion":{"$ref":"#/$defs/q"},"resolution":{"$ref":"#/$defs/q"},"tension":{"$ref":"#/$defs/q"},"metrical":{"$ref":"#/$defs/q"}}},"similarity_q":{"$ref":"#/$defs/q"},"canonical_alignment_key":{"type":"array","prefixItems":[{"type":"integer","minimum":0,"maximum":255},{"type":"integer","minimum":0,"maximum":4095}],"items":false,"minItems":2,"maxItems":2},"result_hash":{"$ref":"#/$defs/sha"}
  },"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"q":{"type":"integer","minimum":0,"maximum":10000}}
}
