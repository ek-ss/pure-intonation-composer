{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/pil_oracle_matrix_receipt.schema.json","title":"PIL Oracle MatrixReceipt v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","suite_hash","case_results","executions","matrix_hash"],
  "properties":{"schema":{"const":"cps.pil-oracle-matrix-receipt"},"schema_version":{"const":"1.0.0"},"suite_hash":{"$ref":"#/$defs/sha"},"case_results":{"type":"array","minItems":1,"maxItems":1024,"items":{"$ref":"#/$defs/result"}},"executions":{"type":"array","minItems":4,"maxItems":128,"items":{"$ref":"#/$defs/execution"}},"matrix_hash":{"$ref":"#/$defs/sha"}},
  "$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"result":{"type":"object","additionalProperties":false,"required":["case_id","report_hash","canonical_report_sha256"],"properties":{"case_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,39}$"},"report_hash":{"$ref":"#/$defs/sha"},"canonical_report_sha256":{"$ref":"#/$defs/sha"}}},"execution":{"type":"object","additionalProperties":false,"required":["pythonhashseed","worker_count","case_results_hash"],"properties":{"pythonhashseed":{"type":"string","pattern":"^(0|[1-9][0-9]{0,9}|random)$"},"worker_count":{"enum":[1,2,4,8]},"case_results_hash":{"$ref":"#/$defs/sha"}}}}
}
