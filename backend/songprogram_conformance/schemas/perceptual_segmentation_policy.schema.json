{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/perceptual_segmentation_policy.schema.json",
  "title": "Perceptual SegmentationPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm", "project_schema_hash", "policy_schema_hash", "grid_divisions_per_beat", "minimum_segment_ticks", "sustained_minimum_ticks", "pitch_distribution_change_q", "duration_coefficient_q", "metrical_coefficient_q", "persistence_coefficient_q", "bass_coefficient_q", "role_gain_q", "bass_role_order", "boundary_priority", "boundary_confidence_q", "policy_hash"],
  "properties": {
    "schema": {"const": "cps.perceptual-segmentation-policy"},
    "schema_version": {"const": "1.0.0"},
    "algorithm": {"const": "pil-harmonic-segmentation-grid-events/v1"},
    "project_schema_hash": {"$ref": "#/$defs/sha"},
    "policy_schema_hash": {"$ref": "#/$defs/sha"},
    "grid_divisions_per_beat": {"enum": [1, 2, 4, 8]},
    "minimum_segment_ticks": {"type": "integer", "minimum": 1, "maximum": 61440},
    "sustained_minimum_ticks": {"type": "integer", "minimum": 1, "maximum": 61440},
    "pitch_distribution_change_q": {"$ref": "#/$defs/q"},
    "duration_coefficient_q": {"$ref": "#/$defs/q"},
    "metrical_coefficient_q": {"$ref": "#/$defs/q"},
    "persistence_coefficient_q": {"$ref": "#/$defs/q"},
    "bass_coefficient_q": {"$ref": "#/$defs/q"},
    "role_gain_q": {"type": "object", "additionalProperties": false, "required": ["drums", "bass", "harmony", "melody", "texture"], "properties": {"drums": {"$ref": "#/$defs/q"}, "bass": {"$ref": "#/$defs/q"}, "harmony": {"$ref": "#/$defs/q"}, "melody": {"$ref": "#/$defs/q"}, "texture": {"$ref": "#/$defs/q"}}},
    "bass_role_order": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["bass", "harmony", "melody", "texture", "drums"]}},
    "boundary_priority": {"type": "array", "prefixItems": [{"const": "endpoint"}, {"const": "bass_change"}, {"const": "sustained_change"}, {"const": "pitch_distribution_change"}, {"const": "metrical"}], "items": false, "minItems": 5, "maxItems": 5},
    "boundary_confidence_q": {"type": "object", "additionalProperties": false, "required": ["endpoint", "bass_change", "sustained_change", "pitch_distribution_change", "metrical"], "properties": {"endpoint": {"const": 10000}, "bass_change": {"$ref": "#/$defs/q"}, "sustained_change": {"$ref": "#/$defs/q"}, "pitch_distribution_change": {"$ref": "#/$defs/q"}, "metrical": {"$ref": "#/$defs/q"}}},
    "policy_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "q": {"type": "integer", "minimum": 0, "maximum": 10000}
  }
}
