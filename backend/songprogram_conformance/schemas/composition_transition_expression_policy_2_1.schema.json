{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/composition_transition_expression_policy_2_1.schema.json",
  "title": "Composition Transition Expression Policy 2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["algorithm", "pre_boundary_window_q", "post_boundary_window_q", "pair_class_map", "classes"],
  "properties": {
    "algorithm": {"const": "pair-conditioned-three-phase-bundle/v1"},
    "pre_boundary_window_q": {"$ref": "#/$defs/qPositive"},
    "post_boundary_window_q": {"$ref": "#/$defs/qPositive"},
    "pair_class_map": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["from_function", "to_function", "transition_class_id"],
        "properties": {
          "from_function": {"$ref": "#/$defs/function"},
          "to_function": {"$ref": "#/$defs/function"},
          "transition_class_id": {"$ref": "#/$defs/id"}
        }
      }
    },
    "classes": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transition_class_id", "expressions"],
        "properties": {
          "transition_class_id": {"$ref": "#/$defs/id"},
          "expressions": {
            "type": "array", "minItems": 2, "maxItems": 16,
            "items": {"$ref": "#/$defs/expression"}
          }
        }
      }
    }
  },
  "$defs": {
    "q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "qPositive": {"type": "integer", "minimum": 1, "maximum": 10000},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
    "role": {"enum": ["drums", "bass", "harmony", "melody", "texture"]},
    "function": {"enum": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"]},
    "roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "none": {"type": "object", "additionalProperties": false, "required": ["op"], "properties": {"op": {"const": "none"}}},
    "preOperation": {
      "oneOf": [
        {"$ref": "#/$defs/none"},
        {"type": "object", "additionalProperties": false, "required": ["op", "subdivision", "intensity_q"], "properties": {"op": {"const": "drum_fill"}, "subdivision": {"enum": [4, 8, 16, 32]}, "intensity_q": {"$ref": "#/$defs/qPositive"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles"], "properties": {"op": {"const": "role_dropout"}, "roles": {"$ref": "#/$defs/roles"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles", "from_q", "to_q"], "properties": {"op": {"const": "density_ramp"}, "roles": {"$ref": "#/$defs/roles"}, "from_q": {"$ref": "#/$defs/q"}, "to_q": {"$ref": "#/$defs/q"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles", "gate_q"], "properties": {"op": {"const": "sustain"}, "roles": {"$ref": "#/$defs/roles"}, "gate_q": {"$ref": "#/$defs/qPositive"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "role", "source"], "properties": {"op": {"const": "pickup"}, "role": {"enum": ["bass", "harmony", "melody", "texture"]}, "source": {"enum": ["destination_hook", "source_motif"]}}}
      ]
    },
    "boundaryOperation": {
      "oneOf": [
        {"$ref": "#/$defs/none"},
        {"type": "object", "additionalProperties": false, "required": ["op", "duration_q"], "properties": {"op": {"const": "silence"}, "duration_q": {"$ref": "#/$defs/qPositive"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "drum_notes", "gain_q"], "properties": {"op": {"const": "impact"}, "drum_notes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 127}}, "gain_q": {"$ref": "#/$defs/qPositive"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles", "gate_q"], "properties": {"op": {"const": "unison_attack"}, "roles": {"$ref": "#/$defs/roles"}, "gate_q": {"$ref": "#/$defs/qPositive"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "target"], "properties": {"op": {"const": "harmonic_resolution"}, "target": {"enum": ["home", "arrival", "open"]}}}
      ]
    },
    "postOperation": {
      "oneOf": [
        {"$ref": "#/$defs/none"},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles", "stagger_q"], "properties": {"op": {"const": "role_entry"}, "roles": {"$ref": "#/$defs/roles"}, "stagger_q": {"$ref": "#/$defs/q"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "variant"], "properties": {"op": {"const": "hook_statement"}, "variant": {"enum": ["root", "answer", "developed"]}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "variant_id"], "properties": {"op": {"const": "groove_variant"}, "variant_id": {"$ref": "#/$defs/id"}}},
        {"type": "object", "additionalProperties": false, "required": ["op", "roles", "duration_q"], "properties": {"op": {"const": "tail_overlap"}, "roles": {"$ref": "#/$defs/roles"}, "duration_q": {"$ref": "#/$defs/qPositive"}}}
      ]
    },
    "expression": {
      "type": "object", "additionalProperties": false,
      "required": ["expression_id", "weight", "pre_boundary", "boundary", "post_boundary"],
      "properties": {
        "expression_id": {"$ref": "#/$defs/id"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "pre_boundary": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/preOperation"}},
        "boundary": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/boundaryOperation"}},
        "post_boundary": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/postOperation"}}
      }
    }
  }
}
