{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/budget_boundary_cases.schema.json",
  "title": "OperationBudget boundary cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "cases"],
  "properties": {
    "schema": {"const": "cps.budget-boundary-cases"},
    "schema_version": {"const": "1.0.0"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "counter", "ceiling", "accepted_charge", "rejected_charge", "expected_code"],
      "properties": {
        "id": {"type": "string"},
        "counter": {"type": "string"},
        "ceiling": {"type": "integer", "minimum": 0},
        "accepted_charge": {"type": "integer", "minimum": 0},
        "rejected_charge": {"type": "integer", "minimum": 1},
        "expected_code": {"type": "string", "pattern": "^BUDGET_[A-Z_]+_EXCEEDED$"}
      }
    }
  }
}
