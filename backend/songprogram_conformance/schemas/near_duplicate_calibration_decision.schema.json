{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/near_duplicate_calibration_decision.schema.json",
  "title": "CPS NearDuplicate CalibrationDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "scope", "status", "fingerprint_spec_hash", "threshold_q", "calibration_dataset_hash", "acceptance_policy_hash", "evidence_summary_hash", "precision_q", "false_accept_q", "false_reject_q", "failure_code", "decision_hash"],
  "properties": {
    "schema": {"const": "cps.near-duplicate-calibration-decision"},
    "schema_version": {"const": "1.0.0"},
    "scope": {"const": "gen0_musical_fingerprint_near_duplicate"},
    "status": {"enum": ["promoted", "rejected"]},
    "fingerprint_spec_hash": {"$ref": "#/$defs/sha"},
    "threshold_q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "calibration_dataset_hash": {"$ref": "#/$defs/sha"},
    "acceptance_policy_hash": {"$ref": "#/$defs/sha"},
    "evidence_summary_hash": {"$ref": "#/$defs/sha"},
    "precision_q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "false_accept_q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "false_reject_q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "failure_code": {"type": ["string", "null"], "enum": [null, "NEAR_DUPLICATE_CALIBRATION_INPUT_INVALID", "NEAR_DUPLICATE_CALIBRATION_CONTEXT_MISMATCH", "NEAR_DUPLICATE_CALIBRATION_THRESHOLD_NOT_MET", "NEAR_DUPLICATE_CALIBRATION_RESULT_INVALID"]},
    "decision_hash": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "promoted"}}, "required": ["status"], "additionalProperties": {}}, "then": {"properties": {"failure_code": {"type": "null"}}, "additionalProperties": {}}},
    {"if": {"properties": {"status": {"const": "rejected"}}, "required": ["status"], "additionalProperties": {}}, "then": {"properties": {"failure_code": {"type": "string"}}, "additionalProperties": {}}}
  ],
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
