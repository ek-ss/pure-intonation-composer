{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/pil_calibration_metric_evidence_summary.schema.json","title":"PIL Phase 1-4 Metric Evidence Summary v1","type":"object","additionalProperties":false,"required":["schema","schema_version","scope","fixture_set_hash","acceptance_policy_hash","metric_registry_hash","listener_count","observation_count","metrics","all_required_metrics_passed","summary_hash"],"properties":{"schema":{"const":"cps.pil-calibration-metric-evidence-summary"},"schema_version":{"const":"1.0.0"},"scope":{"const":"phase_1_4_external"},"fixture_set_hash":{"$ref":"#/$defs/sha"},"acceptance_policy_hash":{"$ref":"#/$defs/sha"},"metric_registry_hash":{"$ref":"#/$defs/sha"},"listener_count":{"type":"integer","minimum":0,"maximum":1000000},"observation_count":{"type":"integer","minimum":0,"maximum":1000000000},"metrics":{"type":"array","minItems":1,"maxItems":32,"items":{"$ref":"#/$defs/evidence"}},"all_required_metrics_passed":{"type":"boolean"},"summary_hash":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"evidence":{"type":"object","additionalProperties":false,"required":["metric_id","aggregation","direction","missing_policy","observed_q","acceptance_threshold_q","passed","source_observation_set_hash","evidence_hash"],"properties":{"metric_id":{"type":"string","pattern":"^pil\\.(?!genre\\.)[a-z][a-z0-9_.]{0,59}$"},"aggregation":{"enum":["minimum","maximum","minimum-runner-up-margin","maximum-absolute"]},"direction":{"enum":["maximize","minimize"]},"missing_policy":{"const":"unavailable"},"observed_q":{"type":["integer","null"],"minimum":0,"maximum":10000},"acceptance_threshold_q":{"type":"integer","minimum":0,"maximum":10000},"passed":{"type":"boolean"},"source_observation_set_hash":{"$ref":"#/$defs/sha"},"evidence_hash":{"$ref":"#/$defs/sha"}}}}}
