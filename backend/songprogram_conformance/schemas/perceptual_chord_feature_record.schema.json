{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/perceptual_chord_feature_record.schema.json",
  "title": "PIL ChordFeatureRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "segment_id", "feature_spec_hash", "native_ji_report_hash", "pitch_distribution_q31", "interval_distribution_q31", "bass_relative_distribution_q31", "register_profile", "common_tone_with_previous_q", "record_hash"],
  "properties": {
    "schema": {"const": "cps.perceptual-chord-feature-record"},
    "schema_version": {"const": "1.0.0"},
    "segment_id": {"type": "string", "pattern": "^seg_[0-9a-f]{32}$"},
    "feature_spec_hash": {"$ref": "#/$defs/sha"},
    "native_ji_report_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "pitch_distribution_q31": {"$ref": "#/$defs/distribution"},
    "interval_distribution_q31": {"$ref": "#/$defs/distribution"},
    "bass_relative_distribution_q31": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/distribution"}]},
    "register_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_absolute_millicents", "maximum_absolute_millicents", "mean_absolute_millicents"],
      "properties": {
        "minimum_absolute_millicents": {"type": "integer"},
        "maximum_absolute_millicents": {"type": "integer"},
        "mean_absolute_millicents": {"type": "integer"}
      }
    },
    "common_tone_with_previous_q": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/q"}]},
    "record_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "weight": {"type": "object", "additionalProperties": false, "required": ["pitch_class_ordinal", "weight_q31"], "properties": {"pitch_class_ordinal": {"type": "integer", "minimum": 0, "maximum": 11}, "weight_q31": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "distribution": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/weight"}}
  }
}
