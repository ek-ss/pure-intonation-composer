{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_soft_reranking_policy.schema.json",
  "title": "PIL Synthetic Soft Reranking Policy v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "schema_version", "authority_effect", "comparison",
    "unavailable_policy", "metric_priorities", "policy_hash"
  ],
  "properties": {
    "schema": {"const": "cps.pil-synthetic-soft-reranking-policy"},
    "schema_version": {"const": "1.0.0"},
    "authority_effect": {"const": "audit_only"},
    "comparison": {"const": "lexicographic_metric_priority_then_context_hash"},
    "unavailable_policy": {"const": "after_available"},
    "metric_priorities": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "direction"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^pil\\.[a-z][a-z0-9_.]{0,59}$"},
          "direction": {"enum": ["maximize", "minimize"]}
        }
      }
    },
    "policy_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
