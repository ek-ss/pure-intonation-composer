{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/perceptual_trajectory_template_set.schema.json","title":"PIL TrajectoryTemplateSet v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","algorithm","template_set_schema_hash","transition_record_schema_hash","trajectory_result_schema_hash","feature_spec_hash","vocabulary_hash","voice_matching_policy_hash","alignment","score_weights","templates","template_set_hash"],
  "properties":{
    "schema":{"const":"cps.perceptual-trajectory-template-set"},"schema_version":{"const":"1.0.0"},"algorithm":{"const":"pil-consecutive-trajectory-l1/v1"},"template_set_schema_hash":{"$ref":"#/$defs/sha"},"transition_record_schema_hash":{"$ref":"#/$defs/sha"},"trajectory_result_schema_hash":{"$ref":"#/$defs/sha"},"feature_spec_hash":{"$ref":"#/$defs/sha"},"vocabulary_hash":{"$ref":"#/$defs/sha"},"voice_matching_policy_hash":{"$ref":"#/$defs/sha"},
    "alignment":{"type":"object","additionalProperties":false,"required":["algorithm","missing_component_policy","maximum_results"],"properties":{"algorithm":{"const":"all-consecutive-windows/v1"},"missing_component_policy":{"const":"omit-and-renormalize/v1"},"maximum_results":{"type":"integer","minimum":1,"maximum":4096}}},
    "score_weights":{"type":"object","additionalProperties":false,"required":["chord","bass","common_tone","contrary_motion","resolution","tension","metrical"],"properties":{"chord":{"$ref":"#/$defs/q"},"bass":{"$ref":"#/$defs/q"},"common_tone":{"$ref":"#/$defs/q"},"contrary_motion":{"$ref":"#/$defs/q"},"resolution":{"$ref":"#/$defs/q"},"tension":{"$ref":"#/$defs/q"},"metrical":{"$ref":"#/$defs/q"}}},
    "templates":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/template"}},"template_set_hash":{"$ref":"#/$defs/sha"}
  },
  "$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"q":{"type":"integer","minimum":0,"maximum":10000},"weight":{"type":"object","additionalProperties":false,"required":["vocabulary_id","weight_q31"],"properties":{"vocabulary_id":{"type":"string"},"weight_q31":{"type":"integer","minimum":1,"maximum":2147483647}}},
    "step":{"type":"object","additionalProperties":false,"required":["chord_targets"],"properties":{"chord_targets":{"type":"array","minItems":1,"maxItems":256,"items":{"$ref":"#/$defs/weight"}}}},
    "transition":{"type":"object","additionalProperties":false,"required":["bass_motion_center_millicents","bass_motion_radius_millicents","common_tone_target_q","contrary_motion_target_q","resolution_kind","resolution_target_q","directed_tension_change_target_q","metrical_target_q"],"properties":{"bass_motion_center_millicents":{"type":"integer","minimum":-600000,"maximum":599999},"bass_motion_radius_millicents":{"type":"integer","minimum":1,"maximum":600000},"common_tone_target_q":{"$ref":"#/$defs/q"},"contrary_motion_target_q":{"$ref":"#/$defs/q"},"resolution_kind":{"enum":["step_up","step_down"]},"resolution_target_q":{"$ref":"#/$defs/q"},"directed_tension_change_target_q":{"type":"integer","minimum":-10000,"maximum":10000},"metrical_target_q":{"$ref":"#/$defs/q"}}},
    "template":{"type":"object","additionalProperties":false,"required":["id","ordinal","steps","transitions"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"ordinal":{"type":"integer","minimum":0,"maximum":255},"steps":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/step"}},"transitions":{"type":"array","minItems":1,"maxItems":15,"items":{"$ref":"#/$defs/transition"}}}}
  }
}
