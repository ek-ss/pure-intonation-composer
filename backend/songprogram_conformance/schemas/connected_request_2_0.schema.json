{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/connected_request_2_0.schema.json",
  "title": "ConnectedRequest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "executor_manifest_digest",
    "executor_manifest",
    "mutation_request",
    "compiler_manifest"
  ],
  "properties": {
    "schema": {
      "const": "cps.connected-request"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "executor_manifest_digest": {
      "$ref": "#/$defs/sha256"
    },
    "executor_manifest": {
      "$ref": "connected_executor_manifest_2_0.schema.json"
    },
    "mutation_request": {
      "$ref": "mutation_application_request_2_0.schema.json"
    },
    "compiler_manifest": {
      "$ref": "compiler_manifest_2_0.schema.json"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
