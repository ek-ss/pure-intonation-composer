{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/calibration_decision.schema.json",
  "title":"CPS Genre CalibrationDecision v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","status","genre_intent_hash","evaluation_manifest_hash","reference_set_manifest_hash","feature_extractor_manifest_hash","renderer_manifest_hash","listener_cohort_manifest_hash","calibration_fixture_set_hash","metric_ids","failure_code","decision_hash"],
  "properties":{
    "schema":{"const":"cps.calibration-decision"},"schema_version":{"const":"1.0.0"},"status":{"enum":["promoted","rejected"]},
    "genre_intent_hash":{"$ref":"#/$defs/sha"},"evaluation_manifest_hash":{"$ref":"#/$defs/sha"},"reference_set_manifest_hash":{"$ref":"#/$defs/sha"},"feature_extractor_manifest_hash":{"$ref":"#/$defs/sha"},"renderer_manifest_hash":{"$ref":"#/$defs/sha"},"listener_cohort_manifest_hash":{"$ref":"#/$defs/sha"},"calibration_fixture_set_hash":{"$ref":"#/$defs/sha"},
    "metric_ids":{"type":"array","maxItems":16,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"}},
    "failure_code":{"type":["string","null"],"enum":[null,"CALIBRATION_INPUT_INVALID","CALIBRATION_CONTEXT_MISMATCH","CALIBRATION_REFERENCE_SET_MISMATCH","CALIBRATION_EXTRACTOR_MISMATCH","CALIBRATION_RENDERER_MISMATCH","CALIBRATION_COHORT_MISMATCH","CALIBRATION_THRESHOLD_NOT_MET","CALIBRATION_RESULT_INVALID"]},"decision_hash":{"$ref":"#/$defs/sha"}
  },"allOf":[
    {"if":{"properties":{"status":{"const":"promoted"}},"required":["status"],"additionalProperties":{}},"then":{"properties":{"metric_ids":{"type":"array","minItems":1},"failure_code":{"type":"null"}},"additionalProperties":{}}},
    {"if":{"properties":{"status":{"const":"rejected"}},"required":["status"],"additionalProperties":{}},"then":{"properties":{"metric_ids":{"type":"array","maxItems":0},"failure_code":{"enum":["CALIBRATION_INPUT_INVALID","CALIBRATION_CONTEXT_MISMATCH","CALIBRATION_REFERENCE_SET_MISMATCH","CALIBRATION_EXTRACTOR_MISMATCH","CALIBRATION_RENDERER_MISMATCH","CALIBRATION_COHORT_MISMATCH","CALIBRATION_THRESHOLD_NOT_MET","CALIBRATION_RESULT_INVALID"]}},"additionalProperties":{}}}
  ],"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
