{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_raw_response_record.schema.json",
  "title": "PIL Synthetic LLM Raw Response Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_kind",
    "human_authority_compatible",
    "human_listener_response",
    "scope",
    "protocol_hash",
    "agent_manifest_hash",
    "sealed_context_hash",
    "request_hash",
    "provider_response_hash",
    "judgments",
    "record_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.pil-synthetic-raw-response-record"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority_kind": {
      "const": "synthetic_llm"
    },
    "human_authority_compatible": {
      "const": false
    },
    "human_listener_response": {
      "const": false
    },
    "scope": {
      "enum": [
        "phase_1_4",
        "genre_phase_5"
      ]
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha"
    },
    "agent_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "sealed_context_hash": {
      "$ref": "#/$defs/sha"
    },
    "request_hash": {
      "$ref": "#/$defs/sha"
    },
    "provider_response_hash": {
      "$ref": "#/$defs/sha"
    },
    "judgments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/judgment"
      }
    },
    "record_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "judgment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "ordinal_label",
        "available"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^pil\\.[a-z][a-z0-9_.]{0,59}$"
        },
        "ordinal_label": {
          "enum": [
            "strongly_below",
            "below",
            "borderline",
            "above",
            "strongly_above",
            "unavailable"
          ]
        },
        "available": {
          "type": "boolean"
        }
      }
    }
  }
}
