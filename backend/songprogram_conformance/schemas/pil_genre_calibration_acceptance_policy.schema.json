{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/pil_genre_calibration_acceptance_policy.schema.json","title":"PIL Genre Phase 5 Calibration Acceptance Policy v1","type":"object","additionalProperties":false,"required":["schema","schema_version","scope","pil_manifest_hash","phase5_build_id","genre_intent_hash","genre_model_hash","genre_reference_set_manifest_hash","genre_metric_registry_hash","minimum_listener_count","minimum_observation_count","metrics","policy_hash"],"properties":{"schema":{"const":"cps.pil-genre-calibration-acceptance-policy"},"schema_version":{"const":"1.0.0"},"scope":{"const":"genre_phase_5"},"pil_manifest_hash":{"$ref":"#/$defs/sha"},"phase5_build_id":{"const":"pil.phase5.1.0.0"},"genre_intent_hash":{"$ref":"#/$defs/sha"},"genre_model_hash":{"$ref":"#/$defs/sha"},"genre_reference_set_manifest_hash":{"$ref":"#/$defs/sha"},"genre_metric_registry_hash":{"$ref":"#/$defs/sha"},"minimum_listener_count":{"type":"integer","minimum":1,"maximum":1000000},"minimum_observation_count":{"type":"integer","minimum":1,"maximum":1000000000},"metrics":{"type":"array","minItems":1,"maxItems":4,"items":{"$ref":"#/$defs/metric"}},"policy_hash":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"metric":{"type":"object","additionalProperties":false,"required":["metric_id","aggregation","direction","missing_policy","acceptance_threshold_q","noninferiority_margin_q","improvement_margin_q"],"properties":{"metric_id":{"type":"string","pattern":"^pil\\.genre\\.[a-z][a-z0-9_]{0,47}$"},"aggregation":{"enum":["minimum","maximum"]},"direction":{"enum":["maximize","minimize"]},"missing_policy":{"const":"unavailable"},"acceptance_threshold_q":{"type":"integer","minimum":0,"maximum":10000},"noninferiority_margin_q":{"type":"integer","minimum":0,"maximum":9999},"improvement_margin_q":{"type":"integer","minimum":1,"maximum":10000}}}}}
