    "genre_reference_feature_records":{"type":"array","minItems":1,"maxItems":4096,"items":{"$ref":"genre_feature_record.schema.json"}},
    "authority_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
  }
}
