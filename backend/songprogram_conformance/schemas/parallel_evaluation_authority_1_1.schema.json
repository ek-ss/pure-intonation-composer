{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/parallel_evaluation_authority_1_1.schema.json",
  "title":"ParallelEvaluationAuthority v1.1","type":"object","additionalProperties":false,
