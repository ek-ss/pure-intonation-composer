{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/render_determinism_matrix_manifest.schema.json",
  "title": "CPS RenderDeterminismMatrixManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "contract", "fixture_set_hash", "project_schema_hash", "catalog_digest", "render_manifest_digest", "renderer_build_hash", "invocation_count", "case_schedule", "python_hash_seeds", "worker_counts", "test_block_sizes", "cases", "manifest_hash"],
  "properties": {
    "schema": {"const": "cps.render-determinism-matrix-manifest"},
    "schema_version": {"const": "1.0.0"},
    "contract": {"const": "gen0-c-render-determinism-matrix/v1"},
    "fixture_set_hash": {"$ref": "#/$defs/sha"},
    "project_schema_hash": {"$ref": "#/$defs/sha"},
    "catalog_digest": {"$ref": "#/$defs/sha"},
    "render_manifest_digest": {"$ref": "#/$defs/sha"},
    "renderer_build_hash": {"$ref": "#/$defs/sha"},
    "invocation_count": {"const": 100},
    "case_schedule": {"const": "invocation-ordinal-mod-case-count/v1"},
    "python_hash_seeds": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1}, {"const": 7}, {"const": 42}], "items": false, "minItems": 4, "maxItems": 4},
    "worker_counts": {"type": "array", "prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}], "items": false, "minItems": 4, "maxItems": 4},
    "test_block_sizes": {"type": "array", "prefixItems": [{"const": 64}, {"const": 256}, {"const": 1024}], "items": false, "minItems": 3, "maxItems": 3},
    "cases": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/$defs/case"}},
    "manifest_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "project_hash", "wav_hash", "pcm_hash", "report_hash", "track_set_hash"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "project_hash": {"$ref": "#/$defs/sha"},
        "wav_hash": {"$ref": "#/$defs/sha"},
        "pcm_hash": {"$ref": "#/$defs/sha"},
        "report_hash": {"$ref": "#/$defs/sha"},
        "track_set_hash": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
