{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/native_ji_evaluation_manifest.schema.json",
  "title":"NativeJIEvaluationManifest 1.0",
  "type":"object",
  "additionalProperties":false,
  "required":["schema","schema_version","algorithm","implementation_build_id","project_schema_hash","report_schema_hash","metric_id","coordinate_order","distance","distance_cap","within_group_weight_q","between_group_weight_q","manifest_hash"],
  "properties":{
    "schema":{"const":"cps.native-ji-evaluation-manifest"},
    "schema_version":{"const":"1.0.0"},
    "algorithm":{"const":"native-ji-lattice-coherence/v1"},
    "implementation_build_id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"},
    "project_schema_hash":{"$ref":"#/$defs/sha"},
    "report_schema_hash":{"$ref":"#/$defs/sha"},
    "metric_id":{"const":"native_ji.coherence"},
    "coordinate_order":{"type":"array","prefixItems":[{"const":"equave_exponent"},{"const":"final_vector"}],"items":false,"minItems":2,"maxItems":2},
    "distance":{"const":"lattice-l1/v1"},
    "distance_cap":{"type":"integer","minimum":1,"maximum":1048576},
    "within_group_weight_q":{"type":"integer","minimum":0,"maximum":10000},
    "between_group_weight_q":{"type":"integer","minimum":0,"maximum":10000},
    "manifest_hash":{"$ref":"#/$defs/sha"}
  },
  "allOf":[{"not":{"properties":{"within_group_weight_q":{"const":0},"between_group_weight_q":{"const":0}},"required":["within_group_weight_q","between_group_weight_q"],"additionalProperties":{}}}],
  "$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}
}
