{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/gen0_cohort_candidate_ledger.schema.json",
  "title": "CPS GEN0 Cohort Candidate Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "cohort_manifest_hash", "records", "ledger_hash"],
  "properties": {
    "schema": {"const": "cps.gen0-cohort-candidate-ledger"},
    "schema_version": {"const": "1.0.0"},
    "cohort_manifest_hash": {"$ref": "#/$defs/sha"},
    "records": {"type": "array", "minItems": 1000, "maxItems": 1000, "items": {"$ref": "gen0_cohort_candidate_record.schema.json"}},
    "ledger_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
