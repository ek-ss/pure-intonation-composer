{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/search_loop_13_fixture_case.schema.json",
  "title": "SearchLoop13 Authoritative Fixture Case v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "case_id", "root_seed", "edge_registry", "inputs", "policies", "budgets", "cache_scenario", "parallel_scenario", "stop_branch", "expected", "case_hash"],
  "properties": {
    "schema": {"const": "cps.search-loop-13-fixture-case"}, "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
    "root_seed": {"$ref": "#/$defs/u64"},
    "edge_registry": {"$ref": "#/$defs/edgeRegistryBinding"},
    "inputs": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/input"}},
    "policies": {"$ref": "#/$defs/policies"}, "budgets": {"$ref": "#/$defs/budgets"}, "cache_scenario":{"$ref":"#/$defs/cacheScenario"}, "parallel_scenario":{"$ref":"#/$defs/parallelScenario"},
    "stop_branch": {"enum": ["accepted", "logical_budget_exhausted", "maximum_rounds", "patience", "cancelled", "conformance_violation"]},
    "expected": {"$ref": "#/$defs/expected"}, "case_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,240}$"},
    "base64": {"type": "string", "pattern": "^[A-Za-z0-9+/]*={0,2}$"},
    "edgeRegistryBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "registry_hash", "registry_schema_hash", "registry_bytes_base64", "registry_schema_bytes_base64"],
      "properties": {
        "path": {"$ref": "#/$defs/path"}, "registry_hash": {"$ref": "#/$defs/sha"},
        "registry_schema_hash": {"$ref": "#/$defs/sha"},
        "registry_bytes_base64": {"$ref": "#/$defs/base64"},
        "registry_schema_bytes_base64": {"$ref": "#/$defs/base64"}
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "raw_file_sha256", "artifact_hash", "schema_hash"],
      "properties": {
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,79}$"}, "path": {"$ref": "#/$defs/path"},
        "raw_file_sha256": {"$ref": "#/$defs/sha"}, "artifact_hash": {"$ref": "#/$defs/sha"}, "schema_hash": {"$ref": "#/$defs/sha"}
      }
    },
    "policies": {
      "type": "object", "additionalProperties": false,
      "required": ["candidate_source_policy_hash", "render_selection_policy_hash", "archive_admission_policy_hash", "challenger_acceptance_policy_hash", "stopping_policy_hash", "planner_branch"],
      "properties": {
        "candidate_source_policy_hash": {"$ref": "#/$defs/sha"}, "render_selection_policy_hash": {"$ref": "#/$defs/sha"},
        "archive_admission_policy_hash": {"$ref": "#/$defs/sha"}, "challenger_acceptance_policy_hash": {"$ref": "#/$defs/sha"},
        "stopping_policy_hash": {"$ref": "#/$defs/sha"}, "planner_branch": {"enum": ["planner", "planner_null"]}
      }
    },
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["population_size", "candidates_per_round", "planner_call_budget", "compile_logical_budget", "render_frame_budget", "operational_deadline_seconds"],
      "properties": {
        "population_size": {"type": "integer", "minimum": 1, "maximum": 10000}, "candidates_per_round": {"type": "integer", "minimum": 1, "maximum": 1000},
        "planner_call_budget": {"$ref": "#/$defs/u64"}, "compile_logical_budget": {"$ref": "#/$defs/u64"}, "render_frame_budget": {"$ref": "#/$defs/u64"},
        "operational_deadline_seconds": {"type": "null"}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "raw_file_sha256", "audio_artifact_hash", "pcm_sha256"],
      "properties": {"path": {"$ref": "#/$defs/path"}, "raw_file_sha256": {"$ref": "#/$defs/sha"}, "audio_artifact_hash": {"$ref": "#/$defs/sha"}, "pcm_sha256": {"$ref": "#/$defs/sha"}}
    },
    "cacheEntry":{"type":"object","additionalProperties":false,"required":["kind","request_hash","entry_hash","raw_entry_bytes_base64","raw_entry_bytes_hash","byte_length"],"properties":{"kind":{"enum":["compile","render"]},"request_hash":{"$ref":"#/$defs/sha"},"entry_hash":{"$ref":"#/$defs/sha"},"raw_entry_bytes_base64":{"$ref":"#/$defs/base64"},"raw_entry_bytes_hash":{"$ref":"#/$defs/sha"},"byte_length":{"$ref":"#/$defs/u64"}}},
    "cacheScenario":{"type":"object","additionalProperties":false,"required":["mode","initial_entries","expected_lookup","expected_corruption_receipt_hash","expected_publication_entry_hash"],"properties":{"mode":{"enum":["cold","hit","corrupt"]},"initial_entries":{"type":"array","maxItems":1024,"items":{"$ref":"#/$defs/cacheEntry"}},"expected_lookup":{"enum":["miss","hit","corrupt_recompute"]},"expected_corruption_receipt_hash":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"expected_publication_entry_hash":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]}}},
    "parallelScenario":{"type":"object","additionalProperties":false,"required":["worker_count","completion_permutation","parity_group_hash"],"properties":{"worker_count":{"enum":[1,2,4,8]},"completion_permutation":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^act_[a-z2-7]{26}$"}},"parity_group_hash":{"$ref":"#/$defs/sha"}}},
    "coordinate":{"type":"object","additionalProperties":false,"required":["round","phase_ordinal","candidate_ordinal","event_ordinal"],"properties":{"round":{"$ref":"#/$defs/u64"},"phase_ordinal":{"type":"integer","minimum":0,"maximum":13},"candidate_ordinal":{"$ref":"#/$defs/u64"},"event_ordinal":{"type":"integer","minimum":0,"maximum":65535}}},
    "violation":{"type":"object","additionalProperties":false,"required":["coordinate","code","evidence_hash"],"properties":{"coordinate":{"$ref":"#/$defs/coordinate"},"code":{"const":"CONFORMANCE_VIOLATION"},"evidence_hash":{"$ref":"#/$defs/sha"}}},
    "expected": {"oneOf":[{"$ref":"#/$defs/normalExpected"},{"$ref":"#/$defs/violationExpected"}]},
    "normalExpected":{"type":"object","additionalProperties":false,"required":["terminal_kind","transcript_root_hash","cas_index_hash","cas_index_schema_hash","cache_publication_index_hash","final_checkpoint_hash","failure","audio_pcm_assets"],"properties":{"terminal_kind":{"const":"checkpoint"},"transcript_root_hash":{"$ref":"#/$defs/sha"},"cas_index_hash":{"$ref":"#/$defs/sha"},"cas_index_schema_hash":{"$ref":"#/$defs/sha"},"cache_publication_index_hash":{"$ref":"#/$defs/sha"},"final_checkpoint_hash":{"$ref":"#/$defs/sha"},"failure":{"type":"null"},"audio_pcm_assets":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/asset"}}}},
    "violationExpected":{"type":"object","additionalProperties":false,"required":["terminal_kind","transcript_root_hash","cas_index_hash","cas_index_schema_hash","cache_publication_index_hash","final_checkpoint_hash","failure","audio_pcm_assets"],"properties":{"terminal_kind":{"const":"conformance_violation"},"transcript_root_hash":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/sha"}]},"cas_index_hash":{"$ref":"#/$defs/sha"},"cas_index_schema_hash":{"$ref":"#/$defs/sha"},"cache_publication_index_hash":{"$ref":"#/$defs/sha"},"final_checkpoint_hash":{"type":"null"},"failure":{"$ref":"#/$defs/violation"},"audio_pcm_assets":{"type":"array","maxItems":64,"items":{"$ref":"#/$defs/asset"}}}}
  }
}
