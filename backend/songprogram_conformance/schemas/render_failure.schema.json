{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/render_failure.schema.json",
  "title": "SearchLoop13 RenderFailure v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "run_hash", "context_hash", "request_hash", "charge_hash", "dispatch_authorization_hash", "code", "evidence_hashes", "failure_hash"],
  "properties": {
    "schema": {"const": "cps.render-failure"}, "schema_version": {"const": "1.0.0"},
    "run_hash": {"$ref": "#/$defs/sha"}, "context_hash": {"$ref": "#/$defs/sha"},
    "request_hash": {"$ref": "#/$defs/sha"}, "charge_hash": {"$ref": "#/$defs/sha"},
    "dispatch_authorization_hash": {"$ref": "#/$defs/sha"},
    "code": {"enum": ["RENDER_REQUEST_INVALID", "RENDER_CONTEXT_MISMATCH", "RENDER_MANIFEST_MISMATCH", "RENDER_PROJECT_MISMATCH", "RENDER_CHARGE_MISMATCH", "RENDER_DISPATCH_AUTHORIZATION_MISMATCH", "RENDER_CACHE_INVALID", "RENDER_CATALOG_MISMATCH", "RENDER_ASSET_INVALID", "RENDER_POLYPHONY_EXCEEDED", "RENDER_ACCUMULATOR_OVERFLOW", "RENDER_RESULT_INVALID"]},
    "evidence_hashes": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}},
    "failure_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
