{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/evaluation_manifest.schema.json",
  "title": "SearchLoop13 EvaluationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "evaluator_id", "evaluator_version", "evaluator_build_hash", "genre_intent_hash", "hard_checks", "metrics", "manifest_hash"],
  "properties": {
    "schema": {"const": "cps.evaluation-manifest"},
    "schema_version": {"const": "1.0.0"},
    "evaluator_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
    "evaluator_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "evaluator_build_hash": {"$ref": "#/$defs/sha"},
    "genre_intent_hash": {"$ref": "#/$defs/sha"},
    "hard_checks": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/hardCheck"}},
    "metrics": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/metric"}},
    "manifest_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_hash", "json_pointer"],
      "properties": {
        "artifact_kind": {"enum": ["project", "compile_report", "fingerprint_record", "near_duplicate_decision", "render_result", "audio_artifact", "genre_intent"]},
        "schema_hash": {"$ref": "#/$defs/sha"},
        "json_pointer": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"}
      }
    },
    "hardCheck": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "required_render"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/source"}, "required_render": {"type": "boolean"}}
    },
    "metric": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source", "direction", "required_render"],
      "properties": {"id": {"$ref": "#/$defs/id"}, "source": {"$ref": "#/$defs/source"}, "direction": {"enum": ["maximize", "minimize"]}, "required_render": {"type": "boolean"}}
    }
  }
}
