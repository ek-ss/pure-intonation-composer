{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/structural_sampler_trace_1_1.schema.json",
  "title": "StructuralSamplerTrace v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_hash",
    "context_hash",
    "source_decision_hash",
    "sampler_request_hash",
    "sampler_manifest_hash",
    "structural_lowering_manifest_hash",
    "structural_program_schema_hash",
    "structural_rejection_evidence_schema_hash",
    "attempts",
    "terminal_attempt_ordinal",
    "trace_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.structural-sampler-trace"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "run_hash": {
      "$ref": "#/$defs/sha"
    },
    "context_hash": {
      "$ref": "#/$defs/sha"
    },
    "source_decision_hash": {
      "$ref": "#/$defs/sha"
    },
    "sampler_request_hash": {
      "$ref": "#/$defs/sha"
    },
    "sampler_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "structural_lowering_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "structural_program_schema_hash": {
      "$ref": "#/$defs/sha"
    },
    "structural_rejection_evidence_schema_hash": {
      "$ref": "#/$defs/sha"
    },
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/accepted"
          },
          {
            "$ref": "#/$defs/rejectedComplete"
          },
          {
            "$ref": "#/$defs/rejectedIncomplete"
          }
        ]
      }
    },
    "terminal_attempt_ordinal": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "trace_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "decision": {
      "$ref": "structural_sampler_trace.schema.json#/$defs/decision"
    },
    "baseAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_ordinal",
        "attempt_seed_hash",
        "decisions",
        "candidate_program_hash",
        "outcome",
        "rejection_evidence",
        "rejection_evidence_hash"
      ],
      "properties": {
        "attempt_ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "attempt_seed_hash": {
          "$ref": "#/$defs/sha"
        },
        "decisions": {
          "type": "array",
          "maxItems": 65536,
          "items": {
            "$ref": "#/$defs/decision"
          }
        },
        "candidate_program_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "accepted",
            "rejected"
          ]
        },
        "rejection_evidence": {
          "oneOf": [
            {
              "$ref": "structural_rejection_evidence_1_1.schema.json"
            },
            {
              "type": "null"
            }
          ]
        },
        "rejection_evidence_hash": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "accepted": {
      "allOf": [
        {
          "$ref": "#/$defs/baseAttempt"
        },
        {
          "properties": {
            "outcome": {
              "const": "accepted"
            },
            "candidate_program_hash": {
              "$ref": "#/$defs/sha"
            },
            "rejection_evidence": {
              "type": "null"
            },
            "rejection_evidence_hash": {
              "type": "null"
            }
          },
          "additionalProperties": {}
        }
      ]
    },
    "rejectedComplete": {
      "allOf": [
        {
          "$ref": "#/$defs/baseAttempt"
        },
        {
          "properties": {
            "outcome": {
              "const": "rejected"
            },
            "candidate_program_hash": {
              "$ref": "#/$defs/sha"
            },
            "rejection_evidence": {
              "$ref": "structural_rejection_evidence_1_1.schema.json"
            },
            "rejection_evidence_hash": {
              "$ref": "#/$defs/sha"
            }
          },
          "additionalProperties": {}
        }
      ]
    },
    "rejectedIncomplete": {
      "allOf": [
        {
          "$ref": "#/$defs/baseAttempt"
        },
        {
          "properties": {
            "outcome": {
              "const": "rejected"
            },
            "candidate_program_hash": {
              "type": "null"
            },
            "rejection_evidence": {
              "$ref": "structural_rejection_evidence_1_1.schema.json"
            },
            "rejection_evidence_hash": {
              "$ref": "#/$defs/sha"
            }
          },
          "additionalProperties": {}
        }
      ]
    }
  }
}
