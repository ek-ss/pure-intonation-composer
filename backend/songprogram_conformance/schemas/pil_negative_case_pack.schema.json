{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/pil_negative_case_pack.schema.json","title":"PIL Negative Case Pack v1","type":"object","additionalProperties":false,"required":["schema","schema_version","pack_version","scope","oracle_suite_hash","oracle_matrix_receipt_hash","cases","pack_hash"],"properties":{"schema":{"const":"cps.pil-negative-case-pack"},"schema_version":{"const":"1.0.0"},"pack_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"scope":{"const":"binding_and_schema_stage"},"oracle_suite_hash":{"$ref":"#/$defs/sha"},"oracle_matrix_receipt_hash":{"$ref":"#/$defs/sha"},"cases":{"type":"array","minItems":2,"maxItems":64,"items":{"$ref":"#/$defs/case"}},"pack_hash":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"case":{"type":"object","additionalProperties":false,"required":["case_id","base_case_id","base_case_raw_sha256","operation","json_pointer","replacement","expected_error","delivery","expected_report"],"properties":{"case_id":{"type":"string","pattern":"^pil_neg_[a-z0-9_]+$"},"base_case_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,39}$"},"base_case_raw_sha256":{"$ref":"#/$defs/sha"},"operation":{"const":"replace"},"json_pointer":{"type":"string","pattern":"^/[^ ]+$"},"replacement":{},"expected_error":{"enum":["PIL_BINDING_MISMATCH","PIL_SCHEMA_INVALID"]},"delivery":{"const":"raise"},"expected_report":{"type":"null"}}}}}
