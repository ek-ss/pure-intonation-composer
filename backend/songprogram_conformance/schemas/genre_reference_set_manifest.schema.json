{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/genre_reference_set_manifest.schema.json",
  "title":"CPS Genre ReferenceSetManifest v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","reference_set_id","feature_extractor_manifest_hash","license_policy_hash","license_policy_schema_hash","source_provenance_schema_hash","members","manifest_hash"],
  "properties":{
    "schema":{"const":"cps.genre-reference-set-manifest"},"schema_version":{"const":"1.0.0"},"reference_set_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},
    "feature_extractor_manifest_hash":{"$ref":"#/$defs/sha"},"license_policy_hash":{"$ref":"#/$defs/sha"},"license_policy_schema_hash":{"$ref":"#/$defs/sha"},"source_provenance_schema_hash":{"$ref":"#/$defs/sha"},
    "members":{"type":"array","minItems":1,"maxItems":4096,"uniqueItems":true,"items":{"$ref":"#/$defs/member"}},"manifest_hash":{"$ref":"#/$defs/sha"}
  },"$defs":{
    "sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "member":{"type":"object","additionalProperties":false,"required":["reference_id","partition","source_provenance_hash","feature_record_hash","raw_audio_hash"],"properties":{"reference_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"partition":{"enum":["calibration","validation","holdout"]},"source_provenance_hash":{"$ref":"#/$defs/sha"},"feature_record_hash":{"$ref":"#/$defs/sha"},"raw_audio_hash":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]}}}
  }
}
