{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_evaluation_policy.schema.json",
  "title": "PIL Synthetic Evaluation Policy v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "schema_version", "authority_effect", "scope",
    "metric_registry_hash", "minimum_agent_count", "ordinal_mapping",
    "even_median", "metrics", "policy_hash"
  ],
  "properties": {
    "schema": {"const": "cps.pil-synthetic-evaluation-policy"},
    "schema_version": {"const": "1.0.0"},
    "authority_effect": {"const": "audit_only"},
    "scope": {"enum": ["phase_1_4", "genre_phase_5"]},
    "metric_registry_hash": {"$ref": "#/$defs/sha"},
    "minimum_agent_count": {"type": "integer", "minimum": 1, "maximum": 10000},
    "ordinal_mapping": {
      "type": "object", "additionalProperties": false,
      "required": ["strongly_below", "below", "borderline", "above", "strongly_above"],
      "properties": {
        "strongly_below": {"const": 0}, "below": {"const": 2500},
        "borderline": {"const": 5000}, "above": {"const": 7500},
        "strongly_above": {"const": 10000}
      }
    },
    "even_median": {"const": "round_half_to_even"},
    "metrics": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "acceptance_threshold_q"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^pil\\.[a-z][a-z0-9_.]{0,59}$"},
          "acceptance_threshold_q": {"type": "integer", "minimum": 0, "maximum": 10000}
        }
      }
    },
    "policy_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
