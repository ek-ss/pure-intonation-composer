{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/progression_query.schema.json",
  "title":"GEN0-B ProgressionQuery v1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","algorithm","numeric_contract","maximum_voice_motion_millicents","crossing_policy","occurrences"],
  "properties":{
    "schema":{"const":"cps.progression-query"},"schema_version":{"const":"1.0.0"},"algorithm":{"const":"gen0-progression-exact/v1"},"numeric_contract":{"const":"cps-numeric/decimal-log2-rhe-v1"},
    "maximum_voice_motion_millicents":{"type":"integer","minimum":0},"crossing_policy":{"enum":["allow","forbid"]},
    "occurrences":{"type":"array","minItems":1,"maxItems":512,"items":{"$ref":"#/$defs/occurrence"}}
  },
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "occurrence":{"type":"object","additionalProperties":false,"required":["id","start_tick","duration_ticks","intent_hash","root_anchor","candidate_core_hashes"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"start_tick":{"type":"integer","minimum":0},"duration_ticks":{"type":"integer","minimum":1},"intent_hash":{"$ref":"#/$defs/sha256"},"root_anchor":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"integer"}},"candidate_core_hashes":{"type":"array","minItems":1,"maxItems":24,"uniqueItems":true,"items":{"$ref":"#/$defs/sha256"}}}}
  }
}
