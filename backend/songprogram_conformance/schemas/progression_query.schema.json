{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/progression_query.schema.json",
  "title": "GEN0-B ProgressionQuery v1.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm", "numeric_contract", "budget_profile", "domain_hash", "domain_equave", "maximum_voice_motion_millicents", "crossing_policy", "occurrences"],
  "properties": {
    "schema": {"const": "cps.progression-query"}, "schema_version": {"const": "1.2.0"},
    "algorithm": {"const": "gen0-progression-exact/v1"}, "numeric_contract": {"const": "cps-numeric/decimal-log2-rhe-v1"},
    "budget_profile": {"const": "gen0-progression-exact-v1"}, "domain_hash": {"$ref": "#/$defs/sha256"}, "domain_equave": {"$ref": "#/$defs/ratio"},
    "maximum_voice_motion_millicents": {"type": "integer", "minimum": 0}, "crossing_policy": {"enum": ["allow", "forbid"]},
    "occurrences": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/occurrence"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ratio": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"},
    "vector": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "integer"}},
    "voice": {"type": "object", "additionalProperties": false, "required": ["target_ordinal", "absolute_vector", "equave_exponent", "exact_ratio", "ratio_millicents"], "properties": {
      "target_ordinal": {"type": "integer", "minimum": 0, "maximum": 7}, "absolute_vector": {"$ref": "#/$defs/vector"},
      "equave_exponent": {"type": "integer", "minimum": -96, "maximum": 96}, "exact_ratio": {"$ref": "#/$defs/ratio"}, "ratio_millicents": {"type": "integer"}
    }},
    "candidate_core": {"type": "object", "additionalProperties": false, "required": ["core_hash", "resolved_chord", "domain_hash", "intent_hash", "anchor_vector", "voices", "local_pair_rms_millicents", "local_pair_max_millicents", "local_complexity"], "properties": {
      "core_hash": {"$ref": "#/$defs/sha256"}, "domain_hash": {"$ref": "#/$defs/sha256"}, "intent_hash": {"$ref": "#/$defs/sha256"},
      "resolved_chord": {"$ref": "arrangement_project_1_2.schema.json#/$defs/resolvedChord"},
      "anchor_vector": {"$ref": "#/$defs/vector"}, "voices": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/voice"}},
      "local_pair_rms_millicents": {"type": "integer", "minimum": 0}, "local_pair_max_millicents": {"type": "integer", "minimum": 0}, "local_complexity": {"type": "integer", "minimum": 0}
    }},
    "occurrence": {"type": "object", "additionalProperties": false, "required": ["id", "start_tick", "duration_ticks", "track_id", "register_millicents", "maximum_polyphony", "overlapping_nonprogression_pitched_events", "intent_hash", "root_anchor", "candidate_cores"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"}, "start_tick": {"type": "integer", "minimum": 0}, "duration_ticks": {"type": "integer", "minimum": 1},
      "track_id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
      "register_millicents": {"type": "array", "minItems": 2, "maxItems": 2, "prefixItems": [{"type": "integer"}, {"type": "integer"}], "items": false},
      "maximum_polyphony": {"type": "integer", "minimum": 1, "maximum": 8}, "overlapping_nonprogression_pitched_events": {"const": 0},
      "intent_hash": {"$ref": "#/$defs/sha256"}, "root_anchor": {"$ref": "#/$defs/vector"},
      "candidate_cores": {"type": "array", "minItems": 1, "maxItems": 24, "items": {"$ref": "#/$defs/candidate_core"}}
    }}
  }
}
