{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/perceptual_interpretation_report.schema.json",
  "title": "PerceptualInterpretationReport v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "project_hash", "manifest_hash", "native_ji_report_hash", "completed_phase", "status", "pitch_records", "segments", "feature_records", "segment_interpretations", "trajectory_interpretations", "genre_interpretations", "missing_groups", "error", "report_hash"],
  "properties": {
    "schema": {"const": "cps.perceptual-interpretation-report"},
    "schema_version": {"const": "1.0.0"},
    "project_hash": {"$ref": "#/$defs/sha"},
    "manifest_hash": {"$ref": "#/$defs/sha"},
    "native_ji_report_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "completed_phase": {"enum": ["pitch_projection", "harmonic_segmentation", "chord_similarity"]},
    "status": {"enum": ["success", "failure"]},
    "pitch_records": {"type": "array", "maxItems": 8192, "items": {"$ref": "#/$defs/pitch"}},
    "segments": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/segment"}},
    "feature_records": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/featureRecord"}},
    "segment_interpretations": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/interpretation"}},
    "trajectory_interpretations": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/similarity"}},
    "genre_interpretations": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/genre"}},
    "missing_groups": {"type": "array", "uniqueItems": true, "items": {"enum": ["harmony", "melody", "rhythm", "form", "instrumentation", "production"]}},
    "error": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^PIL_[A-Z0-9_]+$"}]},
    "report_hash": {"$ref": "#/$defs/sha"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "success"}}, "required": ["status"], "additionalProperties": {}},
      "then": {"properties": {"error": {"type": "null"}}, "additionalProperties": {}}
    },
    {
      "if": {"properties": {"status": {"const": "failure"}}, "required": ["status"], "additionalProperties": {}},
      "then": {"properties": {"error": {"type": "string", "pattern": "^PIL_[A-Z0-9_]+$"}}, "additionalProperties": {}}
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "q": {"type": "integer", "minimum": 0, "maximum": 10000},
    "pitch": {"type": "object", "additionalProperties": false, "required": ["source_event_id", "source_ratio", "frequency_millihz", "absolute_millicents", "native_phase_millicents", "interpretation_phase_millicents", "mapping_q31"], "properties": {"source_event_id": {"type": "string"}, "source_ratio": {"type": "string", "pattern": "^[1-9][0-9]*/[1-9][0-9]*$"}, "frequency_millihz": {"type": "integer", "minimum": 1}, "absolute_millicents": {"type": "integer"}, "native_phase_millicents": {"type": "integer", "minimum": 0}, "interpretation_phase_millicents": {"type": "integer", "minimum": 0, "maximum": 1199999}, "mapping_q31": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pitchWeight"}}}},
    "pitchWeight": {"type": "object", "additionalProperties": false, "required": ["pitch_class_ordinal", "weight_q31"], "properties": {"pitch_class_ordinal": {"type": "integer", "minimum": 0, "maximum": 11}, "weight_q31": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "segment": {"type": "object", "additionalProperties": false, "required": ["segment_id", "start_tick", "end_tick", "boundary_reasons", "source_event_ids", "weighted_pitch_distribution_q31", "bass_event_id", "confidence_q"], "properties": {"segment_id": {"type": "string", "pattern": "^seg_[0-9a-f]{32}$"}, "start_tick": {"type": "integer", "minimum": 0}, "end_tick": {"type": "integer", "minimum": 1}, "boundary_reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["endpoint", "bass_change", "sustained_change", "pitch_distribution_change", "metrical"]}}, "source_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "weighted_pitch_distribution_q31": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pitchWeight"}}, "bass_event_id": {"oneOf": [{"type": "null"}, {"type": "string"}]}, "confidence_q": {"$ref": "#/$defs/q"}}},
    "featureRecord": {"type": "object", "additionalProperties": false, "required": ["schema", "schema_version", "segment_id", "feature_spec_hash", "native_ji_report_hash", "pitch_distribution_q31", "interval_distribution_q31", "bass_relative_distribution_q31", "register_profile", "common_tone_with_previous_q", "record_hash"], "properties": {"schema": {"const": "cps.perceptual-chord-feature-record"}, "schema_version": {"const": "1.0.0"}, "segment_id": {"type": "string", "pattern": "^seg_[0-9a-f]{32}$"}, "feature_spec_hash": {"$ref": "#/$defs/sha"}, "native_ji_report_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]}, "pitch_distribution_q31": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pitchWeight"}}, "interval_distribution_q31": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pitchWeight"}}, "bass_relative_distribution_q31": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/pitchWeight"}}]}, "register_profile": {"type": "object", "additionalProperties": false, "required": ["minimum_absolute_millicents", "maximum_absolute_millicents", "mean_absolute_millicents"], "properties": {"minimum_absolute_millicents": {"type": "integer"}, "maximum_absolute_millicents": {"type": "integer"}, "mean_absolute_millicents": {"type": "integer"}}}, "common_tone_with_previous_q": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/q"}]}, "record_hash": {"$ref": "#/$defs/sha"}}},
    "similarity": {"type": "object", "additionalProperties": false, "required": ["id", "similarity_q"], "properties": {"id": {"type": "string"}, "similarity_q": {"$ref": "#/$defs/q"}}},
    "interpretation": {"type": "object", "additionalProperties": false, "required": ["segment_id", "feature_record_hash", "candidates", "best_label", "confidence_q"], "properties": {"segment_id": {"type": "string"}, "feature_record_hash": {"$ref": "#/$defs/sha"}, "candidates": {"type": "array", "items": {"$ref": "#/$defs/similarity"}}, "best_label": {"oneOf": [{"type": "null"}, {"type": "string"}]}, "confidence_q": {"$ref": "#/$defs/q"}}},
    "genre": {"type": "object", "additionalProperties": false, "required": ["genre_id", "typicality_q", "idiomaticity_q", "cliche_dependence_q", "novelty_q"], "properties": {"genre_id": {"type": "string"}, "typicality_q": {"$ref": "#/$defs/q"}, "idiomaticity_q": {"$ref": "#/$defs/q"}, "cliche_dependence_q": {"$ref": "#/$defs/q"}, "novelty_q": {"$ref": "#/$defs/q"}}}
  }
}
