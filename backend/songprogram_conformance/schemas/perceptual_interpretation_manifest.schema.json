{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/perceptual_interpretation_manifest.schema.json",
  "title": "PerceptualInterpretationManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm", "project_schema_hash", "numeric_contract_hash", "implementation_build_id", "interpretation_period", "pitch_kernel", "segmentation_policy_schema_hash", "segmentation_policy_hash", "feature_spec_hash", "vocabulary_hash", "voice_matching_policy_hash", "trajectory_template_set_hash", "genre_model_hash", "manifest_hash"],
  "properties": {
    "schema": {"const": "cps.perceptual-interpretation-manifest"},
    "schema_version": {"const": "1.0.0"},
    "algorithm": {"const": "pil-parallel-interpretation/v1"},
    "project_schema_hash": {"$ref": "#/$defs/sha"},
    "numeric_contract_hash": {"$ref": "#/$defs/sha"},
    "implementation_build_id": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "interpretation_period": {"const": "2/1"},
    "pitch_kernel": {"type": "object", "additionalProperties": false, "required": ["algorithm", "radius_millicents", "normalization_total"], "properties": {"algorithm": {"const": "triangular-millicent-q31/v1"}, "radius_millicents": {"type": "integer", "minimum": 1, "maximum": 600000}, "normalization_total": {"const": 2147483647}}},
    "segmentation_policy_schema_hash": {"$ref": "#/$defs/sha"},
    "segmentation_policy_hash": {"$ref": "#/$defs/sha"},
    "feature_spec_hash": {"$ref": "#/$defs/sha"},
    "vocabulary_hash": {"$ref": "#/$defs/sha"},
    "voice_matching_policy_hash": {"$ref": "#/$defs/sha"},
    "trajectory_template_set_hash": {"$ref": "#/$defs/sha"},
    "genre_model_hash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha"}]},
    "manifest_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
