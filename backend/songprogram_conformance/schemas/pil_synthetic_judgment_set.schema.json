{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_judgment_set.schema.json",
  "title": "PIL Synthetic LLM Judgment Set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_kind",
    "human_authority_compatible",
    "human_listener_evidence",
    "authority_effect",
    "scope",
    "protocol_hash",
    "cohort_manifest_hash",
    "assignment_set_hash",
    "sealed_context_set_hash",
    "response_record_hashes",
    "response_count",
    "partition_membership_hash",
    "partition_leakage_count",
    "judgment_set_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.pil-synthetic-judgment-set"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority_kind": {
      "const": "synthetic_llm"
    },
    "human_authority_compatible": {
      "const": false
    },
    "human_listener_evidence": {
      "const": false
    },
    "authority_effect": {
      "const": "audit_only"
    },
    "scope": {
      "enum": [
        "phase_1_4",
        "genre_phase_5"
      ]
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha"
    },
    "cohort_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "assignment_set_hash": {
      "$ref": "#/$defs/sha"
    },
    "sealed_context_set_hash": {
      "$ref": "#/$defs/sha"
    },
    "response_record_hashes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha"
      }
    },
    "response_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "partition_membership_hash": {
      "$ref": "#/$defs/sha"
    },
    "partition_leakage_count": {
      "const": 0
    },
    "judgment_set_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
