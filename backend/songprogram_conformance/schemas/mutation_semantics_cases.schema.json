{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/mutation_semantics_cases.schema.json","title":"CPS Mutation Semantics Cases v1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","rotation","choice","lineage_creation"],
  "properties":{"schema":{"const":"cps.mutation-semantics-cases"},"schema_version":{"const":"1.0.0"},"rotation":{"$ref":"#/$defs/rotation"},"choice":{"$ref":"#/$defs/choice"},"lineage_creation":{"$ref":"#/$defs/lineage"}},
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,79}$"},
    "step":{"type":"object","additionalProperties":false,"required":["at_tick","duration_ticks","accent_q","lane_id"],"properties":{"at_tick":{"type":"integer","minimum":0},"duration_ticks":{"type":"integer","minimum":1},"accent_q":{"type":"integer","minimum":0,"maximum":10000},"lane_id":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/id"}]}}},
    "rotation":{"type":"object","additionalProperties":false,"required":["length_ticks","steps","displacement_steps","expected_quantum_ticks","expected_onsets"],"properties":{"length_ticks":{"type":"integer","minimum":1},"steps":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/step"}},"displacement_steps":{"type":"integer"},"expected_quantum_ticks":{"type":"integer","minimum":1},"expected_onsets":{"type":"array","items":{"type":"integer","minimum":0}}}},
    "choice":{"type":"object","additionalProperties":false,"required":["choice_id","owner_kind","field","value"],"properties":{"choice_id":{"type":"string","pattern":"^choice_[a-z2-7]{20}$"},"owner_kind":{"enum":["section","material","track","production"]},"field":{"enum":["role","development_stage","mapping","profile_id"]},"value":{"oneOf":[{"type":"string"},{"type":"integer"},{"type":"boolean"}]}}},
    "lineage":{"type":"object","additionalProperties":false,"required":["action_id","mutation_id","creation_ordinal","material_core","expected_root_hash","expected_edge_operation"],"properties":{"action_id":{"type":"string","pattern":"^act_[a-z2-7]{26}$"},"mutation_id":{"type":"string","pattern":"^mut_[a-z2-7]{20}$"},"creation_ordinal":{"type":"integer","minimum":0,"maximum":4294967295},"material_core":{"type":"object","additionalProperties":{}},"expected_root_hash":{"$ref":"#/$defs/sha256"},"expected_edge_operation":{"type":"string","maxLength":80}}}
  }
}
