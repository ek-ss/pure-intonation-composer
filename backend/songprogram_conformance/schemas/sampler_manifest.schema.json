    "chordValue":{"type":"object","additionalProperties":false,"required":["equave","divisions","steps"],"properties":{"equave":{"$ref":"#/$defs/ratio"},"divisions":{"type":"integer","minimum":1,"maximum":96},"steps":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"integer","minimum":0,"maximum":95}}}},
    "chordChoice":{"type":"object","additionalProperties":false,"required":["value","weight"],"properties":{"value":{"$ref":"#/$defs/chordValue"},"weight":{"$ref":"#/$defs/weight"}}},
    "instrumentMap":{"type":"object","additionalProperties":false,"required":["drums","bass","harmony","melody","texture"],"properties":{"drums":{"$ref":"#/$defs/id"},"bass":{"$ref":"#/$defs/id"},"harmony":{"$ref":"#/$defs/id"},"melody":{"$ref":"#/$defs/id"},"texture":{"$ref":"#/$defs/id"}}},
    "instrumentChoice":{"type":"object","additionalProperties":false,"required":["value","weight"],"properties":{"value":{"$ref":"#/$defs/instrumentMap"},"weight":{"$ref":"#/$defs/weight"}}},
    "intTable":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/intChoice"}},"boolTable":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/boolChoice"}},
    "limits":{"type":"object","additionalProperties":false,"required":["minimum_sections","maximum_sections","minimum_bars","maximum_bars","minimum_materials","maximum_materials","minimum_sounding_roles","maximum_transforms_per_recall"],"properties":{"minimum_sections":{"const":3},"maximum_sections":{"const":8},"minimum_bars":{"const":16},"maximum_bars":{"const":64},"minimum_materials":{"const":2},"maximum_materials":{"const":5},"minimum_sounding_roles":{"const":3},"maximum_transforms_per_recall":{"const":3}}},
    "tables":{"type":"object","additionalProperties":false,"required":["section_count","section_role","section_bars","total_bars","material_count","material_kind","active_roles","equave_domain","rhythm_grid","rhythm_density","chord_reference","recall_decision","transform_count","transform_type","rotate_amount","track_instrument_by_role","gain_q","pan_q"],"properties":{"section_count":{"$ref":"#/$defs/intTable"},"section_role":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/roleChoice"}},"section_bars":{"$ref":"#/$defs/intTable"},"total_bars":{"$ref":"#/$defs/intTable"},"material_count":{"$ref":"#/$defs/intTable"},"material_kind":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/materialKindChoice"}},"active_roles":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/activeRolesChoice"}},"equave_domain":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/domainChoice"}},"rhythm_grid":{"$ref":"#/$defs/intTable"},"rhythm_density":{"$ref":"#/$defs/intTable"},"chord_reference":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/chordChoice"}},"recall_decision":{"$ref":"#/$defs/boolTable"},"transform_count":{"$ref":"#/$defs/intTable"},"transform_type":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/transformChoice"}},"rotate_amount":{"$ref":"#/$defs/intTable"},"track_instrument_by_role":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/instrumentChoice"}},"gain_q":{"$ref":"#/$defs/intTable"},"pan_q":{"$ref":"#/$defs/intTable"}}},
    "decision":{"type":"object","additionalProperties":false,"required":["ordinal","stage","path","table","repeat"],"properties":{"ordinal":{"type":"integer","minimum":0,"maximum":17},"stage":{"enum":["form","materials","realizations","tracks","production"]},"path":{"type":"array","minItems":1,"items":{"type":"string","pattern":"^[a-z0-9_{}-]+$"}},"table":{"enum":["section_count","section_role","section_bars","total_bars","material_count","material_kind","active_roles","equave_domain","rhythm_grid","rhythm_density","chord_reference","recall_decision","transform_count","transform_type","rotate_amount","track_instrument_by_role","gain_q","pan_q"]},"repeat":{"enum":["once","per_section","per_material","per_recall","per_role"]}}}
  }
