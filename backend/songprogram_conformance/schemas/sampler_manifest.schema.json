{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/sampler_manifest.schema.json","title":"CPS SamplerManifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","algorithm","choice_algorithm","stream_algorithm","song_program_schema_hash","compiler_manifest_hash","instrument_catalog_digest","maximum_rejections_per_seed","limits","tables","decision_program"],
  "properties":{"schema":{"const":"cps.sampler-manifest"},"schema_version":{"const":"1.0.0"},"algorithm":{"const":"broad_prior_v1"},"choice_algorithm":{"const":"sha256-u64-mod-cumulative/v1"},"stream_algorithm":{"const":"path-addressed-sha256/v1"},"song_program_schema_hash":{"$ref":"#/$defs/sha256"},"compiler_manifest_hash":{"$ref":"#/$defs/sha256"},"instrument_catalog_digest":{"$ref":"#/$defs/sha256"},"maximum_rejections_per_seed":{"type":"integer","minimum":1,"maximum":256},"limits":{"$ref":"#/$defs/limits"},"tables":{"$ref":"#/$defs/tables"},"decision_program":{"type":"array","minItems":18,"maxItems":18,"items":{"$ref":"#/$defs/decision"}}},
  "$defs":{
    "sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"ratio":{"type":"string","pattern":"^[1-9][0-9]*/[1-9][0-9]*$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,79}$"},
