    "activeRolesChoice":{"type":"object","additionalProperties":false,"required":["value","weight"],"properties":{"value":{"type":"array","minItems":3,"maxItems":5,"uniqueItems":true,"items":{"enum":["drums","bass","harmony","melody","texture"]}},"weight":{"$ref":"#/$defs/weight"}}},
    "bound":{"type":"array","prefixItems":[{"type":"integer","minimum":-32,"maximum":32},{"type":"integer","minimum":-32,"maximum":32}],"items":false,"minItems":2,"maxItems":2},
    "domainValue":{"type":"object","additionalProperties":false,"required":["equave","generators","coordinate_bounds","register_bounds"],"properties":{"equave":{"$ref":"#/$defs/ratio"},"generators":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/ratio"}},"coordinate_bounds":{"type":"array","minItems":1,"maxItems":3,"items":{"$ref":"#/$defs/bound"}},"register_bounds":{"$ref":"#/$defs/bound"}}},
