{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/progression_result.schema.json",
  "title":"GEN0-B ProgressionResult v1.1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","search_completeness","selected_core_hashes","edge_matching_keys","score_prefix","canonical_path_key","path_hash"],
  "properties":{
    "schema":{"const":"cps.progression-result"},"schema_version":{"const":"1.1.0"},"search_completeness":{"const":"exact"},
    "selected_core_hashes":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sha256"}},
    "edge_matching_keys":{"type":"array","items":{"$ref":"#/$defs/matchingKey"}},
    "score_prefix":{"type":"array","minItems":11,"maxItems":11,"items":{"type":"integer","minimum":0}},
    "canonical_path_key":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["occurrence_id","resolved_core_hash","matching_key"],"properties":{"occurrence_id":{"type":"string"},"resolved_core_hash":{"$ref":"#/$defs/sha256"},"matching_key":{"oneOf":[{"$ref":"#/$defs/matchingKey"},{"type":"null"}]}}}},
    "path_hash":{"$ref":"#/$defs/sha256"}
  },
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"matchingKey":{"type":"array","minItems":8,"maxItems":26,"items":{"type":"integer","minimum":0,"maximum":8}}}
}
