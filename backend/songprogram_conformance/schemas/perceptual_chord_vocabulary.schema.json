{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/perceptual_chord_vocabulary.schema.json",
  "title": "PIL ChordVocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm", "vocabulary_schema_hash", "interpretation_period", "feature_spec_hash", "entries", "vocabulary_hash"],
  "properties": {
    "schema": {"const": "cps.perceptual-chord-vocabulary"},
    "schema_version": {"const": "1.0.0"},
    "algorithm": {"const": "pil-chord-vocabulary-q31/v1"},
    "vocabulary_schema_hash": {"$ref": "#/$defs/sha"},
    "interpretation_period": {"const": "2/1"},
    "feature_spec_hash": {"$ref": "#/$defs/sha"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/entry"}},
    "vocabulary_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "weight": {"type": "object", "additionalProperties": false, "required": ["pitch_class_ordinal", "weight_q31"], "properties": {"pitch_class_ordinal": {"type": "integer", "minimum": 0, "maximum": 11}, "weight_q31": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "distribution": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/weight"}},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "ordinal", "functional_tension_q", "pitch_distribution_q31", "interval_distribution_q31", "bass_relative_distribution_q31"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"},
        "ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "functional_tension_q": {"type": "integer", "minimum": 0, "maximum": 10000},
        "pitch_distribution_q31": {"$ref": "#/$defs/distribution"},
        "interval_distribution_q31": {"$ref": "#/$defs/distribution"},
        "bass_relative_distribution_q31": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/distribution"}]}
      }
    }
  }
}
