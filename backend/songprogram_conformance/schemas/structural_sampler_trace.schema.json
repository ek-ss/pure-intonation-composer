{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/structural_sampler_trace.schema.json",
  "title": "SearchLoop13 StructuralSamplerTrace v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "run_hash", "context_hash", "source_decision_hash", "sampler_request_hash", "sampler_manifest_hash", "attempts", "terminal_attempt_ordinal", "trace_hash"],
  "properties": {
    "schema": {"const": "cps.structural-sampler-trace"},
    "schema_version": {"const": "1.0.0"},
    "run_hash": {"$ref": "#/$defs/sha"},
    "context_hash": {"$ref": "#/$defs/sha"},
    "source_decision_hash": {"$ref": "#/$defs/sha"},
    "sampler_request_hash": {"$ref": "#/$defs/sha"},
    "sampler_manifest_hash": {"$ref": "#/$defs/sha"},
    "attempts": {"type": "array", "minItems": 1, "maxItems": 256, "items": {"$ref": "#/$defs/attempt"}},
    "terminal_attempt_ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
    "trace_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "path_segment": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 128}, {"$ref": "#/$defs/u64"}]},
    "eligible_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["index", "choice_id", "value_hash", "weight"],
      "properties": {
        "index": {"$ref": "#/$defs/u64"},
        "choice_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "value_hash": {"$ref": "#/$defs/sha"},
        "weight": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_ordinal", "path", "counter", "table", "table_hash", "selected_index", "selected_value_hash", "row_hash"],
      "properties": {
        "decision_ordinal": {"$ref": "#/$defs/u64"},
        "path": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/path_segment"}},
        "counter": {"$ref": "#/$defs/u64"},
        "table": {"type": "array", "minItems": 1, "maxItems": 4096, "items": {"$ref": "#/$defs/eligible_entry"}},
        "table_hash": {"$ref": "#/$defs/sha"},
        "selected_index": {"$ref": "#/$defs/u64"},
        "selected_value_hash": {"$ref": "#/$defs/sha"},
        "row_hash": {"$ref": "#/$defs/sha"}
      }
    },
    "rejection": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "constraint_id", "evidence_pointer", "evidence_hash"],
      "properties": {
        "code": {"type": "string", "pattern": "^SAMPLER_[A-Z0-9_]{2,72}$"},
        "constraint_id": {"type": "string", "minLength": 1, "maxLength": 80},
        "evidence_pointer": {"type": "string", "pattern": "^(|/(?:[^~/]|~0|~1)*)$"},
        "evidence_hash": {"$ref": "#/$defs/sha"}
      }
    },
    "attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_ordinal", "attempt_seed_hash", "decisions", "candidate_program_hash", "outcome", "rejection"],
      "properties": {
        "attempt_ordinal": {"type": "integer", "minimum": 0, "maximum": 255},
        "attempt_seed_hash": {"$ref": "#/$defs/sha"},
        "decisions": {"type": "array", "maxItems": 65536, "items": {"$ref": "#/$defs/decision"}},
        "candidate_program_hash": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
        "outcome": {"enum": ["accepted", "rejected"]},
        "rejection": {"oneOf": [{"$ref": "#/$defs/rejection"}, {"type": "null"}]}
      }
    }
  }
}
