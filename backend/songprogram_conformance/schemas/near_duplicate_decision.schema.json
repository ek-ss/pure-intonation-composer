{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/near_duplicate_decision.schema.json",
  "title": "CPS NearDuplicateDecision v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "run_hash",
    "fingerprint_spec_hash",
    "candidate_ordinal",
    "candidate_program_hash",
    "candidate_fingerprint_hash",
    "comparison_set_hash",
    "comparison_program_hashes",
    "nearest",
    "threshold_q",
    "classification",
    "representative_program_hash",
    "decision_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.near-duplicate-decision"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "run_hash": {
      "$ref": "#/$defs/sha"
    },
    "fingerprint_spec_hash": {
      "$ref": "#/$defs/sha"
    },
    "candidate_ordinal": {
      "$ref": "#/$defs/u64"
    },
    "candidate_program_hash": {
      "$ref": "#/$defs/sha"
    },
    "candidate_fingerprint_hash": {
      "$ref": "#/$defs/sha"
    },
    "comparison_set_hash": {
      "$ref": "#/$defs/sha"
    },
    "comparison_program_hashes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha" }
    },
    "nearest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/nearest"
        }
      ]
    },
    "threshold_q": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "classification": {
      "enum": [
        "exact_duplicate",
        "near_duplicate",
        "distinct"
      ]
    },
    "representative_program_hash": {
      "$ref": "#/$defs/sha"
    },
    "decision_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "nearest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_hash",
        "fingerprint_hash",
        "component_distances_q",
        "aggregate_distance_q"
      ],
      "properties": {
        "program_hash": {
          "$ref": "#/$defs/sha"
        },
        "fingerprint_hash": {
          "$ref": "#/$defs/sha"
        },
        "component_distances_q": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          }
        },
        "aggregate_distance_q": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      }
    }
  }
}
