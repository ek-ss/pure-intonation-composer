    "pair":{"type":"object","additionalProperties":false,"required":["from_event_id","to_event_id","absolute_motion_millicents","circular_motion_millicents","pair_cost_q","common_tone_q","step_up_likeness_q","step_down_likeness_q"],"properties":{"from_event_id":{"type":"string"},"to_event_id":{"type":"string"},"absolute_motion_millicents":{"type":"integer"},"circular_motion_millicents":{"type":"integer","minimum":-600000,"maximum":599999},"pair_cost_q":{"$ref":"#/$defs/q"},"common_tone_q":{"$ref":"#/$defs/q"},"step_up_likeness_q":{"$ref":"#/$defs/q"},"step_down_likeness_q":{"$ref":"#/$defs/q"}}}
  }
}
