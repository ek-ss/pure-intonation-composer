{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/negative_cases.schema.json",
  "title": "CPS Negative Mutation Cases v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "base_path", "cases"],
  "properties": {
    "schema": {"const": "cps.negative-mutation-cases"},
    "schema_version": {"const": "1.0.0"},
    "base_path": {"type": "string", "minLength": 1},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mutation", "expected"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,79}$"},
        "mutation": {"$ref": "#/$defs/mutation"},
        "expected": {"$ref": "#/$defs/error"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "pointer", "value"],
      "properties": {
        "op": {"enum": ["add", "replace"]},
        "pointer": {"type": "string", "pattern": "^/"},
        "value": {}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "stage", "pointer"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
        "stage": {"type": "string", "minLength": 1},
        "pointer": {"type": "string"}
      }
    }
  }
}
