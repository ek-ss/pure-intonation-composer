{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/challenger_acceptance_decision_1_1.schema.json","title":"ChallengerAcceptanceDecision v1.1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","run_hash","policy_hash","calibration_decision_hash","challenger_program_hash","champion_program_hash","metric_comparisons","hard_checks_passed","pareto_result","accepted","resulting_champion_program_hash","decision_hash"],
  "properties":{"schema":{"const":"cps.challenger-acceptance-decision"},"schema_version":{"const":"1.1.0"},"run_hash":{"$ref":"#/$defs/sha"},"policy_hash":{"$ref":"#/$defs/sha"},"calibration_decision_hash":{"$ref":"#/$defs/sha"},"challenger_program_hash":{"$ref":"#/$defs/sha"},"champion_program_hash":{"oneOf":[{"$ref":"#/$defs/sha"},{"type":"null"}]},"metric_comparisons":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/comparison"}},"hard_checks_passed":{"type":"boolean"},"pareto_result":{"enum":["challenger_dominates","champion_dominates","non_dominated","no_champion","ineligible"]},"accepted":{"type":"boolean"},"resulting_champion_program_hash":{"$ref":"#/$defs/sha"},"decision_hash":{"$ref":"#/$defs/sha"}},
