{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/candidate_source_policy.schema.json",
  "title": "CPS CandidateSourcePolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "selection_algorithm",
    "source_cycle",
    "initial_sampler",
    "archive_parent",
    "locked_roots_rule"
  ],
  "properties": {
    "schema": {"const": "cps.candidate-source-policy"},
    "schema_version": {"const": "1.0.0"},
    "selection_algorithm": {"const": "candidate-ordinal-mod-source-cycle/v1"},
    "source_cycle": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"enum": ["initial_sampler", "archive_parent"]}
    },
    "initial_sampler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampler_manifest_hash", "cohort_index_rule", "production_required"],
      "properties": {
        "sampler_manifest_hash": {"$ref": "#/$defs/sha"},
        "cohort_index_rule": {"const": "candidate-ordinal/v1"},
        "production_required": {"const": true}
      }
    },
    "archive_parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qd_manifest_hash", "selection", "parent_index_rule", "empty_archive_behavior"],
      "properties": {
        "qd_manifest_hash": {"$ref": "#/$defs/sha"},
        "selection": {"const": "round-start-champions-cell-then-program-hash/v1"},
        "parent_index_rule": {"const": "source-occurrence-ordinal-mod-sorted-round-start-champions/v1"},
        "empty_archive_behavior": {"const": "initial_sampler/v1"}
      }
    },
    "locked_roots_rule": {"const": "candidate-source-decision-bound/v1"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
