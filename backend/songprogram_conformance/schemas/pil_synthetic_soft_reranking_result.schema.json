{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_soft_reranking_result.schema.json",
  "title": "PIL Synthetic Soft Reranking Result v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "schema_version", "authority_effect", "run_context_hash",
    "policy_hash", "input_context_hashes", "shadow_order", "result_hash"
  ],
  "properties": {
    "schema": {"const": "cps.pil-synthetic-soft-reranking-result"},
    "schema_version": {"const": "1.0.0"},
    "authority_effect": {"const": "audit_only"},
    "run_context_hash": {"$ref": "#/$defs/sha"},
    "policy_hash": {"$ref": "#/$defs/sha"},
    "input_context_hashes": {
      "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "shadow_order": {
      "type": "array", "minItems": 1, "maxItems": 100000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "result_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
