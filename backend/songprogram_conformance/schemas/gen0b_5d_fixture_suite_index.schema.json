{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/gen0b_5d_fixture_suite_index.schema.json",
  "title": "GEN0-B five-dimensional authoritative fixture suite index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "authority_status", "generator_identity", "contract", "coverage", "files", "file_sha256", "schema_sha256", "expected_hashes", "execution", "suite_hash"],
  "properties": {
    "schema": {"const": "cps.gen0b-5d-fixture-suite-index"},
    "schema_version": {"const": "1.0.0"},
    "authority_status": {"const": "authoritative"},
    "generator_identity": {"const": "cps-independent-gen0b-5d-oracle/1.0.0"},
    "contract": {"const": "cps-gen0b-5d-authoritative/v1"},
    "coverage": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+\\.json$"}},
    "file_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha"}},
    "schema_sha256": {"type": "object", "minProperties": 8, "additionalProperties": {"$ref": "#/$defs/sha"}},
    "expected_hashes": {"type": "object", "additionalProperties": false, "required": ["project_hash", "evidence_hash", "melody_report_hash", "root_opcode_stream_hash"], "properties": {"project_hash": {"$ref": "#/$defs/sha"}, "evidence_hash": {"$ref": "#/$defs/sha"}, "melody_report_hash": {"$ref": "#/$defs/sha"}, "root_opcode_stream_hash": {"$ref": "#/$defs/sha"}}},
    "execution": {"type": "object", "additionalProperties": false, "required": ["worker_counts", "pythonhashseeds"], "properties": {"worker_counts": {"prefixItems": [{"const": 1}, {"const": 2}, {"const": 4}, {"const": 8}], "items": false}, "pythonhashseeds": {"prefixItems": [{"const": "0"}, {"const": "1"}, {"const": "7"}, {"const": "42"}], "items": false}}},
    "suite_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
