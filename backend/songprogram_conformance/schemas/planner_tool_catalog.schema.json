{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/planner_tool_catalog.schema.json",
  "title": "PlannerToolCatalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "json_schema_dialect",
    "tools",
    "catalog_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.planner-tool-catalog"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "json_schema_dialect": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/tool"
      }
    },
    "catalog_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description_utf8",
        "input_schema_hash",
        "canonical_schema_bytes_base64",
        "byte_length",
        "declaration_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
        },
        "description_utf8": {
          "type": "string",
          "maxLength": 4096
        },
        "input_schema_hash": {"$ref":"#/$defs/sha"},
        "canonical_schema_bytes_base64": {"type":"string","pattern":"^[A-Za-z0-9+/]*={0,2}$"},
        "byte_length": {"type":"integer","minimum":2,"maximum":1048576},
        "declaration_hash": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
