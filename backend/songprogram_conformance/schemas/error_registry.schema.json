{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://cps.local/schemas/error_registry.schema.json", "title":"CPS Conformance Error Registry v1",
  "type":"object","additionalProperties":false,"required":["schema","schema_version","errors"],
  "properties":{"schema":{"const":"cps.error-registry"},"schema_version":{"const":"1.0.0"},"errors":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/error"}}},
  "$defs":{"error":{"type":"object","additionalProperties":false,"required":["code","stage","pointer_template","description"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"},"stage":{"enum":["schema","references","provenance","numeric","hash","budget","capability","canonicalization"]},"pointer_template":{"type":"string","pattern":"^(|/(?:[^~/]|~0|~1|\\{[a-z_]+\\})*)$"},"description":{"type":"string","minLength":1,"maxLength":240}}}}
}
