{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/fixture_edge_registry.schema.json",
  "title": "SearchLoop13 FixtureEdgeRegistry v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "entries", "registry_hash"],
  "properties": {
    "schema": {"const": "cps.fixture-edge-registry"}, "schema_version": {"const": "1.0.0"},
    "entries": {"type": "array", "minItems": 1, "maxItems": 512, "items": {"$ref": "#/$defs/schemaEntry"}},
    "registry_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "pointer": {"type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"},
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["json_pointer", "target_kind", "nullable", "cardinality"],
      "properties": {
        "json_pointer": {"$ref": "#/$defs/pointer"},
        "target_kind": {"enum": ["cas_json", "raw_pcm", "raw_schema", "external", "comparator"]},
        "nullable": {"type": "boolean"},
        "cardinality": {"enum": ["one", "zero_or_one", "many"]}
      }
    },
    "schemaEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "canonical_root_role", "edges"],
      "properties": {
        "schema_id": {"type": "string", "pattern": "^cps\\.[a-z0-9.-]{1,127}$"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "canonical_root_role": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}]},
        "edges": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/edge"}}
      }
    }
  }
}
