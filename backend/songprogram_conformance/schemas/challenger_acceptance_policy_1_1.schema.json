{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/challenger_acceptance_policy_1_1.schema.json","title":"ChallengerAcceptancePolicy v1.1","type":"object","additionalProperties":false,
  "required":["schema","schema_version","genre_intent_hash","calibration_decision_hash","evaluation_manifest_hash","required_hard_checks","metrics","pareto_rule","tie_rule"],
  "properties":{"schema":{"const":"cps.challenger-acceptance-policy"},"schema_version":{"const":"1.1.0"},"genre_intent_hash":{"$ref":"#/$defs/sha"},"calibration_decision_hash":{"$ref":"#/$defs/sha"},"evaluation_manifest_hash":{"$ref":"#/$defs/sha"},"required_hard_checks":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}},"metrics":{"type":"array","minItems":2,"maxItems":16,"items":{"$ref":"#/$defs/metric"}},"pareto_rule":{"const":"all-noninferior-one-improved/v1"},"tie_rule":{"const":"calibrated-margin-tuple-then-program-hash/v1"}},
  "$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"id":{"type":"string","pattern":"^[a-z][a-z0-9_]{0,63}$"},"metric":{"type":"object","additionalProperties":false,"required":["id","direction","noninferiority_margin_q","improvement_margin_q","ordinal","source_hash"],"properties":{"id":{"$ref":"#/$defs/id"},"direction":{"enum":["maximize","minimize"]},"noninferiority_margin_q":{"type":"integer","minimum":0,"maximum":9999},"improvement_margin_q":{"type":"integer","minimum":1,"maximum":10000},"ordinal":{"type":"integer","minimum":0,"maximum":15},"source_hash":{"$ref":"#/$defs/sha"}}}}
}
