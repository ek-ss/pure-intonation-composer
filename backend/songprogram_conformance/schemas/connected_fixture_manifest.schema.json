{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/connected_fixture_manifest.schema.json",
  "title": "ConnectedFixtureManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "cases",
    "independent_generator",
    "independent_verifier",
    "manifest_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.connected-fixture-manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "independent_generator": {
      "type": "string",
      "minLength": 1
    },
    "independent_verifier": {
      "type": "string",
      "minLength": 1
    },
    "manifest_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\)[^/]+(?:/[^/]+)*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "pipeline",
        "connected_request_hash",
        "request",
        "cold_output",
        "opcode_stream_bundle",
        "valid_cache_entry",
        "corruption"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
        },
        "pipeline": {
          "const": "connected_candidate"
        },
        "connected_request_hash": {
          "$ref": "#/$defs/sha256"
        },
        "request": {
          "$ref": "#/$defs/file"
        },
        "cold_output": {
          "$ref": "#/$defs/file"
        },
        "opcode_stream_bundle": {
          "oneOf": [
            {
              "$ref": "#/$defs/file"
            },
            {
              "type": "null"
            }
          ]
        },
        "valid_cache_entry": {
          "$ref": "#/$defs/file"
        },
        "corruption": {
          "oneOf": [
            {
              "$ref": "#/$defs/jsonCorruption"
            },
            {
              "$ref": "#/$defs/rawCorruption"
            }
          ]
        }
      }
    },
    "jsonCorruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "json_pointer",
        "replacement",
        "expected_first_failed_check"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "json_replace"
        },
        "json_pointer": {
          "type": "string"
        },
        "replacement": {},
        "expected_first_failed_check": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "rawCorruption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "corrupted_entry",
        "expected_first_failed_check"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "raw_fixture"
        },
        "corrupted_entry": {
          "$ref": "#/$defs/file"
        },
        "expected_first_failed_check": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "check": {
      "enum": [
        "framing",
        "schema",
        "canonical",
        "path_key",
        "requested_key",
        "entry_hash",
        "logical_output_hash",
        "receipt_hash",
        "opcode_hash",
        "artifact_hash",
        "cross_binding",
        "independent_validation"
      ]
    }
  }
}
