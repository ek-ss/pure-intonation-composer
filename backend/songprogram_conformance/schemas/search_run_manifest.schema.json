{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/search_run_manifest.schema.json",
  "title":"GEN0-D/LLM Search RunManifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","root_seed","sampler_manifest_hash","compiler_manifest_hash","evaluation_manifest_hash","qd_manifest_hash","planner_manifest_hash","population_size","maximum_rounds","candidates_per_round","patience_rounds","planner_call_budget","compile_logical_budget","render_frame_budget","operational_deadline_seconds"],
  "properties":{
