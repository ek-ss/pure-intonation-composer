{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_judge_response.schema.json",
  "title": "PIL Synthetic Judge Response v1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "judgments"],
  "properties": {
    "schema": {"const": "cps.pil-synthetic-judge-response"},
    "schema_version": {"const": "1.0.0"},
    "judgments": {
      "type": "array", "minItems": 1, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["metric_id", "ordinal_label", "available"],
        "properties": {
          "metric_id": {"type": "string", "pattern": "^pil\\.[a-z][a-z0-9_.]{0,59}$"},
          "ordinal_label": {
            "enum": [
              "strongly_below", "below", "borderline", "above",
              "strongly_above", "unavailable"
            ]
          },
          "available": {"type": "boolean"}
        }
      }
    }
  }
}
