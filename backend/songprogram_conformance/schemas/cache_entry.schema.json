{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://cps.local/schemas/cache_entry.schema.json", "title":"CPS Chord CacheEntry v1",
  "type":"object","additionalProperties":false,"required":["schema","schema_version","key","value","receipt","created_by"],
  "properties":{"schema":{"const":"cps.chord-cache-entry"},"schema_version":{"const":"1.0.0"},"key":{"$ref":"#/$defs/key"},"value":{"$ref":"#/$defs/value"},"receipt":{"$ref":"charge_receipt.schema.json"},"created_by":{"type":"string","minLength":1,"maxLength":160}},
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"key":{"type":"object","additionalProperties":false,"required":["cache_key_hash","canonical_query_hash","algorithm","numeric_contract","resolver_profile_hash","budget_profile_digest"],"properties":{"cache_key_hash":{"$ref":"#/$defs/sha256"},"canonical_query_hash":{"$ref":"#/$defs/sha256"},"algorithm":{"const":"sp0-exhaustive-joint/v1"},"numeric_contract":{"const":"cps-numeric/decimal-log2-rhe-v1"},"resolver_profile_hash":{"$ref":"#/$defs/sha256"},"budget_profile_digest":{"$ref":"#/$defs/sha256"}}},"value":{"type":"object","additionalProperties":false,"required":["status","resolved_chord_id","failure_code","canonical_value_hash"],"properties":{"status":{"enum":["resolved","no_solution"]},"resolved_chord_id":{"type":["string","null"],"pattern":"^rc_[a-z2-7]{26}$"},"failure_code":{"type":["string","null"],"pattern":"^[A-Z][A-Z0-9_]{2,79}$"},"canonical_value_hash":{"$ref":"#/$defs/sha256"}}}}
}
