{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/connected_runner_matrix.schema.json",
  "title": "ConnectedRunnerMatrix v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "fixture_set_hash",
    "cases",
    "matrix_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.connected-runner-matrix"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "fixture_set_hash": {
      "$ref": "#/$defs/sha256"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    },
    "matrix_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "pipeline",
        "request_core",
        "semantic_input_hash",
        "semantic_request_hash",
        "expected_result_hash",
        "expected_stdout_sha256",
        "cells"
      ],
      "properties": {
        "case_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,79}$"
        },
        "pipeline": {
          "const": "connected_candidate"
        },
        "request_core": {
          "$ref": "#/$defs/file"
        },
        "semantic_input_hash": {
          "$ref": "#/$defs/sha256"
        },
        "semantic_request_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_result_hash": {
          "$ref": "#/$defs/sha256"
        },
        "expected_stdout_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "cells": {
          "type": "array",
          "minItems": 12,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker_count",
        "cache_mode",
        "corruption_id",
        "request",
        "expected_exit_code"
      ],
      "properties": {
        "worker_count": {
          "enum": [
            1,
            2,
            4,
            8
          ]
        },
        "cache_mode": {
          "enum": [
            "cold",
            "hit",
            "corrupt"
          ]
        },
        "corruption_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "request": {
          "$ref": "#/$defs/file"
        },
        "expected_exit_code": {
          "const": 0
        }
      }
    }
  }
}
