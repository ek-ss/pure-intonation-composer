{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/section_arrangement_plan.schema.json",
  "title": "CPS Section Arrangement Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_hash", "source_program_id", "section_plans", "distinct_role_mask_count", "sounding_role_count", "status", "plan_hash"],
  "properties": {
    "schema": {"const": "cps.section-arrangement-plan"},
    "schema_version": {"const": "1.0.0"},
    "profile_hash": {"$ref": "#/$defs/sha256"},
    "source_program_id": {"$ref": "#/$defs/id"},
    "section_plans": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["section_id", "section_role", "development_stage", "active_roles", "velocity_scale_q"],
        "properties": {
          "section_id": {"$ref": "#/$defs/id"},
          "section_role": {"$ref": "#/$defs/sectionRole"},
          "development_stage": {"enum": ["introduce", "repeat", "develop", "contrast", "recall", "close"]},
          "active_roles": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
          "velocity_scale_q": {"type": "integer", "minimum": 1, "maximum": 10000}
        }
      }
    },
    "distinct_role_mask_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "sounding_role_count": {"type": "integer", "minimum": 1, "maximum": 5},
    "status": {"enum": ["passed", "rejected"]},
    "plan_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,39}$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "role": {"enum": ["drums", "bass", "harmony", "melody", "texture"]},
    "sectionRole": {"enum": ["intro", "verse", "build", "drop", "break", "final", "outro"]}
  }
}
