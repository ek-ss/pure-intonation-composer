{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/archive_admission_policy.schema.json",
  "title": "CPS ArchiveAdmissionPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "qd_manifest_hash",
    "required_hard_checks",
    "duplicate_rule",
    "quality_components",
    "tie_break"
  ],
  "properties": {
    "schema": {
      "const": "cps.archive-admission-policy"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "qd_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "required_hard_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "duplicate_rule": {
      "const": "distinct-only/v1"
    },
    "quality_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "tie_break": {
      "const": "quality-lexicographic-then-program-hash/v1"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "direction",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_hash", "json_pointer"],
      "properties": {
        "artifact_kind": { "enum": ["evaluation_report", "compile_report", "fingerprint_record"] },
        "schema_hash": { "$ref": "#/$defs/sha" },
        "json_pointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
      }
    }
  }
}
