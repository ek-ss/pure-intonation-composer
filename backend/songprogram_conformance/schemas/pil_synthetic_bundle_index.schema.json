{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_bundle_index.schema.json",
  "title": "PIL Synthetic Authority Bundle Index v1",
  "type": "object", "additionalProperties": false,
  "required": [
    "schema", "schema_version", "authority_kind", "human_authority_compatible",
    "protocol_hash", "agent_manifest_hashes", "cohort_manifest_hash",
    "assignment_set_hash", "response_record_hashes", "judgment_set_hash",
    "registry_hash", "evidence_summary_hash", "decision_hash", "bundle_hash"
  ],
  "properties": {
    "schema": {"const": "cps.pil-synthetic-bundle-index"},
    "schema_version": {"const": "1.0.0"},
    "authority_kind": {"const": "synthetic_llm"},
    "human_authority_compatible": {"const": false},
    "protocol_hash": {"$ref": "#/$defs/sha"},
    "agent_manifest_hashes": {
      "type": "array", "minItems": 1, "maxItems": 10000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "cohort_manifest_hash": {"$ref": "#/$defs/sha"},
    "assignment_set_hash": {"$ref": "#/$defs/sha"},
    "response_record_hashes": {
      "type": "array", "minItems": 1, "maxItems": 1000000, "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha"}
    },
    "judgment_set_hash": {"$ref": "#/$defs/sha"},
    "registry_hash": {"$ref": "#/$defs/sha"},
    "evidence_summary_hash": {"$ref": "#/$defs/sha"},
    "decision_hash": {"$ref": "#/$defs/sha"},
    "bundle_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {"sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
