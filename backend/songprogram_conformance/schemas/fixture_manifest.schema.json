{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://cps.local/schemas/fixture_manifest.schema.json", "title":"CPS Conformance FixtureManifest v1",
  "type":"object","additionalProperties":false,"required":["schema","schema_version","pack_version","contract_versions","source_commit","generated_by","independently_verified_by","fixtures"],
  "properties":{"schema":{"const":"cps.conformance-fixture-manifest"},"schema_version":{"const":"1.0.0"},"pack_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"contract_versions":{"type":"object","additionalProperties":false,"required":["song_program","arrangement_project","numeric","budget"],"properties":{"song_program":{"const":"0.1.0"},"arrangement_project":{"const":"1.2.0"},"numeric":{"const":"cps-numeric/decimal-log2-rhe-v1"},"budget":{"const":"operation-budget-ledger-v1"}}},"source_commit":{"type":"string","pattern":"^[0-9a-f]{7,64}$"},"generated_by":{"type":"string","minLength":1,"maxLength":160},"independently_verified_by":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":160}},"fixtures":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/fixture"}}},
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"fixture":{"type":"object","additionalProperties":false,"required":["id","kind","input_path","input_sha256","expected_path","expected_sha256","schema_path","expected_status","expected_error"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,79}$"},"kind":{"enum":["positive","negative","boundary","numeric","budget","canonicalization"]},"input_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},"input_sha256":{"$ref":"#/$defs/sha256"},"expected_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},"expected_sha256":{"$ref":"#/$defs/sha256"},"schema_path":{"type":"string","pattern":"^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.schema\\.json$"},"expected_status":{"enum":["pass","fail"]},"expected_error":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/error"}]} }},"error":{"type":"object","additionalProperties":false,"required":["code","stage","pointer"],"properties":{"code":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{2,79}$"},"stage":{"type":"string","minLength":1,"maxLength":80},"pointer":{"type":"string","pattern":"^(|/(?:[^~/]|~0|~1)*)$"}}}}
}
