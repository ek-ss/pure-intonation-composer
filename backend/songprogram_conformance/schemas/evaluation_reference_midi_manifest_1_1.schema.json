{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/evaluation_reference_midi_manifest_1_1.schema.json",
  "title": "Evaluation Reference MIDI Manifest 1.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "algorithm", "numeric_contract", "pitch_bend_range_semitones", "program_by_role", "program_by_track", "midi_hash", "manifest_hash"],
  "properties": {
    "schema": {"const": "cps.evaluation-reference-midi-manifest"},
    "schema_version": {"const": "1.1.0"},
    "algorithm": {"const": "smf1-named-tracks-per-note-pitch-bend/v1"},
    "numeric_contract": {"const": "cps-numeric/decimal-log2-rhe-v1"},
    "pitch_bend_range_semitones": {"const": 2},
    "program_by_role": {
      "type": "object", "additionalProperties": false,
      "required": ["bass", "harmony", "melody", "texture"],
      "properties": {
        "bass": {"type": "integer", "minimum": 0, "maximum": 127},
        "harmony": {"type": "integer", "minimum": 0, "maximum": 127},
        "melody": {"type": "integer", "minimum": 0, "maximum": 127},
        "texture": {"type": "integer", "minimum": 0, "maximum": 127}
      }
    },
    "program_by_track": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_-]{0,39}$"},
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 127}
    },
    "midi_hash": {"$ref": "#/$defs/sha256"},
    "manifest_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}
}
