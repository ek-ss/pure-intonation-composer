{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/render_selection_policy.schema.json",
  "title": "CPS RenderSelectionPolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "render_manifest_digest",
    "maximum_renders_per_round",
    "preview_content_frames",
    "tail_rule",
    "candidate_filter",
    "order_components",
    "tie_break",
    "charge_unit"
  ],
  "properties": {
    "schema": {
      "const": "cps.render-selection-policy"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "render_manifest_digest": {
      "$ref": "#/$defs/sha"
    },
    "maximum_renders_per_round": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "preview_content_frames": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "tail_rule": {
      "const": "render-manifest-trailing-zero-frames/v1"
    },
    "candidate_filter": {
      "const": "compile-valid-distinct-only/v1"
    },
    "order_components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
          "required": [
            "id",
            "direction",
            "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
            "direction": {
            "enum": [
              "maximize",
              "minimize"
            ]
            },
            "source": {
              "type": "object", "additionalProperties": false,
              "required": ["artifact_kind", "schema_hash", "json_pointer"],
              "properties": {
                "artifact_kind": { "enum": ["evaluation_report", "compile_report", "fingerprint_record"] },
                "schema_hash": { "$ref": "#/$defs/sha" },
                "json_pointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
              }
            }
        }
      }
    },
    "tie_break": {
      "const": "program-hash-ascending/v1"
    },
    "charge_unit": {
      "const": "output_frame"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
