{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/pil_synthetic_evidence_summary.schema.json",
  "title": "PIL Synthetic LLM Evidence Summary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_kind",
    "human_authority_compatible",
    "human_listener_evidence",
    "authority_effect",
    "scope",
    "protocol_hash",
    "cohort_manifest_hash",
    "judgment_set_hash",
    "metric_registry_hash",
    "evaluation_policy_hash",
    "agent_count",
    "observation_count",
    "aggregation_algorithm",
    "metrics",
    "all_required_metrics_passed",
    "summary_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.pil-synthetic-evidence-summary"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "authority_kind": {
      "const": "synthetic_llm"
    },
    "human_authority_compatible": {
      "const": false
    },
    "human_listener_evidence": {
      "const": false
    },
    "authority_effect": {
      "const": "audit_only"
    },
    "scope": {
      "enum": [
        "phase_1_4",
        "genre_phase_5"
      ]
    },
    "protocol_hash": {
      "$ref": "#/$defs/sha"
    },
    "cohort_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "judgment_set_hash": {
      "$ref": "#/$defs/sha"
    },
    "metric_registry_hash": {
      "$ref": "#/$defs/sha"
    },
    "evaluation_policy_hash": {
      "$ref": "#/$defs/sha"
    },
    "agent_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "observation_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "aggregation_algorithm": {
      "const": "ordinal-label-median-q/v1"
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "all_required_metrics_passed": {
      "type": "boolean"
    },
    "summary_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "q": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_id",
        "aggregation",
        "direction",
        "missing_policy",
        "observed_q",
        "acceptance_threshold_q",
        "passed",
        "source_judgment_hash",
        "evidence_hash"
      ],
      "properties": {
        "metric_id": {
          "type": "string",
          "pattern": "^pil\\.[a-z][a-z0-9_.]{0,59}$"
        },
        "aggregation": {
          "enum": [
            "minimum",
            "maximum",
            "minimum-runner-up-margin",
            "maximum-absolute"
          ]
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "missing_policy": {
          "const": "unavailable"
        },
        "observed_q": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/q"
            }
          ]
        },
        "acceptance_threshold_q": {
          "$ref": "#/$defs/q"
        },
        "passed": {
          "type": "boolean"
        },
        "source_judgment_hash": {
          "$ref": "#/$defs/sha"
        },
        "evidence_hash": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  }
}
