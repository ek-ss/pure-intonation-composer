{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://cps.local/schemas/render_manifest.schema.json",
  "title":"CPS RenderManifest v1",
  "type":"object","additionalProperties":false,
  "required":["schema","schema_version","renderer_build","catalog_digest","contracts","numeric_constants","render_manifest_digest"],
  "properties":{"schema":{"const":"cps.render-manifest"},"schema_version":{"const":"1.0.0"},"renderer_build":{"$ref":"#/$defs/build"},"catalog_digest":{"$ref":"#/$defs/sha256"},"contracts":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/contract"}},"numeric_constants":{"$ref":"#/$defs/constants"},"render_manifest_digest":{"$ref":"#/$defs/sha256"}},
  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"build":{"type":"object","additionalProperties":false,"required":["implementation_id","source_artifact","source_sha256","dependency_lock_sha256"],"properties":{"implementation_id":{"const":"cps-reference-renderer"},"source_artifact":{"type":"string","minLength":1,"maxLength":200},"source_sha256":{"$ref":"#/$defs/sha256"},"dependency_lock_sha256":{"$ref":"#/$defs/sha256"}}},"contract":{"type":"object","additionalProperties":false,"required":["id","version","raw_bytes_sha256"],"properties":{"id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,79}$"},"version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},"raw_bytes_sha256":{"$ref":"#/$defs/sha256"}}},"constants":{"type":"object","additionalProperties":false,"required":["engine","output_sample_rate","output_channels","sample_bits","q_fractional_bits","phase_fractional_bits","block_frames","trailing_zero_frames","multiply_rounding","accumulator_bits","final_conversion"],"properties":{"engine":{"const":"sample-linear-q31/v1"},"output_sample_rate":{"const":48000},"output_channels":{"const":2},"sample_bits":{"const":32},"q_fractional_bits":{"const":31},"phase_fractional_bits":{"const":32},"block_frames":{"const":256},"trailing_zero_frames":{"const":256},"multiply_rounding":{"const":"round-half-to-even"},"accumulator_bits":{"const":64},"final_conversion":{"const":"saturate-once"}}}}
}
