{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/gen0_cohort_candidate_record.schema.json",
  "title": "CPS GEN0 CohortCandidateRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "cohort_manifest_hash", "candidate_ordinal", "root_seed", "cohort_index", "terminal_stage", "terminal_code", "artifact_hashes", "compile_success", "automatic_viable", "has_transformed_recall", "duplicate_classification", "qd_cell", "mode_keys", "record_hash"],
  "properties": {
    "schema": {"const": "cps.gen0-cohort-candidate-record"},
    "schema_version": {"const": "1.0.0"},
    "cohort_manifest_hash": {"$ref": "#/$defs/sha"},
    "candidate_ordinal": {"$ref": "#/$defs/ordinal"},
    "root_seed": {"$ref": "#/$defs/u64"},
    "cohort_index": {"$ref": "#/$defs/ordinal"},
    "terminal_stage": {"enum": ["sampler", "production", "compiler", "evaluation", "fingerprint", "duplicate", "complete"]},
    "terminal_code": {"type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{0,127}$"},
    "artifact_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sampler_result", "production_result", "program", "compile_report", "project", "evaluation_report", "fingerprint_record", "near_duplicate_decision"],
      "properties": {
        "sampler_result": {"$ref": "#/$defs/nullableSha"},
        "production_result": {"$ref": "#/$defs/nullableSha"},
        "program": {"$ref": "#/$defs/nullableSha"},
        "compile_report": {"$ref": "#/$defs/nullableSha"},
        "project": {"$ref": "#/$defs/nullableSha"},
        "evaluation_report": {"$ref": "#/$defs/nullableSha"},
        "fingerprint_record": {"$ref": "#/$defs/nullableSha"},
        "near_duplicate_decision": {"$ref": "#/$defs/nullableSha"}
      }
    },
    "compile_success": {"type": "boolean"},
    "automatic_viable": {"type": "boolean"},
    "has_transformed_recall": {"type": "boolean"},
    "duplicate_classification": {"type": ["string", "null"], "enum": ["exact_duplicate", "near_duplicate", "distinct", null]},
    "qd_cell": {"oneOf": [{"type": "null"}, {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0}}]},
    "mode_keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_anchor_ngram", "chord_intent_ngram", "harmony_rhythm_fingerprint"],
      "properties": {
        "root_anchor_ngram": {"$ref": "#/$defs/keySet"},
        "chord_intent_ngram": {"$ref": "#/$defs/keySet"},
        "harmony_rhythm_fingerprint": {"$ref": "#/$defs/keySet"}
      }
    },
    "record_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "nullableSha": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "ordinal": {"type": "integer", "minimum": 0, "maximum": 999},
    "keySet": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sha"}}
  }
}
