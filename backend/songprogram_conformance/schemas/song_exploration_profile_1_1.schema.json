{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/song_exploration_profile_1_1.schema.json",
  "title": "CPS Song Exploration Profile 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "section_layouts", "role_order", "single_role_binding", "realization_policy", "arrangement_policy", "coverage_gate", "profile_hash"],
  "properties": {
    "schema": {"const": "cps.song-preview-exploration-profile"},
    "schema_version": {"const": "1.1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "profile_hash": {"$ref": "#/$defs/sha256"},
    "section_layouts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["section_count", "bars_per_section"], "properties": {"section_count": {"type": "integer", "minimum": 2, "maximum": 64}, "bars_per_section": {"type": "integer", "minimum": 1, "maximum": 64}}}},
    "role_order": {"const": ["drums", "bass", "harmony", "melody", "texture"]},
    "single_role_binding": {"type": "object", "additionalProperties": false, "required": ["algorithm", "role_weights"], "properties": {"algorithm": {"const": "seeded-weighted-owner-with-role-specialization/v1"}, "role_weights": {"$ref": "#/$defs/rolePositiveMap"}}},
    "realization_policy": {"$ref": "#/$defs/rolePolicyMap"},
    "arrangement_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["algorithm", "minimum_distinct_role_masks", "role_count_choices_by_section_role", "role_priority_by_section_role", "velocity_scale_q_by_section_role"],
      "properties": {
        "algorithm": {"const": "section-role-mask-and-recall/v1.1"},
        "minimum_distinct_role_masks": {"type": "integer", "minimum": 2, "maximum": 64},
        "role_count_choices_by_section_role": {"$ref": "#/$defs/sectionCountMap"},
        "role_priority_by_section_role": {"$ref": "#/$defs/sectionPriorityMap"},
        "velocity_scale_q_by_section_role": {"$ref": "#/$defs/sectionVelocityMap"}
      }
    },
    "coverage_gate": {"type": "object", "additionalProperties": false, "required": ["continuous_section_roles", "maximum_empty_bar_run_continuous", "maximum_empty_bar_run_other", "maximum_fully_silent_one_second_windows", "minimum_overall_coverage_bp", "minimum_sounding_roles"], "properties": {"continuous_section_roles": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/sectionRole"}}, "maximum_empty_bar_run_continuous": {"type": "integer", "minimum": 0, "maximum": 64}, "maximum_empty_bar_run_other": {"type": "integer", "minimum": 0, "maximum": 64}, "maximum_fully_silent_one_second_windows": {"type": "integer", "minimum": 0, "maximum": 65535}, "minimum_overall_coverage_bp": {"type": "integer", "minimum": 0, "maximum": 10000}, "minimum_sounding_roles": {"type": "integer", "minimum": 1, "maximum": 5}}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "role": {"enum": ["drums", "bass", "harmony", "melody", "texture"]},
    "sectionRole": {"enum": ["intro", "verse", "build", "drop", "break", "final", "outro"]},
    "positiveChoices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "qChoices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 10000}},
    "rolePositiveMap": {"type": "object", "additionalProperties": false, "required": ["drums", "bass", "harmony", "melody", "texture"], "properties": {"drums": {"type": "integer", "minimum": 1}, "bass": {"type": "integer", "minimum": 1}, "harmony": {"type": "integer", "minimum": 1}, "melody": {"type": "integer", "minimum": 1}, "texture": {"type": "integer", "minimum": 1}}},
    "rolePolicy": {"type": "object", "additionalProperties": false, "required": ["entry_bar_choices", "period_bars", "duration_ticks", "gate_q"], "properties": {"entry_bar_choices": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}}, "period_bars": {"type": "integer", "minimum": 1}, "duration_ticks": {"$ref": "#/$defs/positiveChoices"}, "gate_q": {"$ref": "#/$defs/qChoices"}}},
    "rolePolicyMap": {"type": "object", "additionalProperties": false, "required": ["drums", "bass", "harmony", "melody", "texture"], "properties": {"drums": {"$ref": "#/$defs/rolePolicy"}, "bass": {"$ref": "#/$defs/rolePolicy"}, "harmony": {"$ref": "#/$defs/rolePolicy"}, "melody": {"$ref": "#/$defs/rolePolicy"}, "texture": {"$ref": "#/$defs/rolePolicy"}}},
    "sectionCountMap": {"type": "object", "additionalProperties": false, "required": ["intro", "verse", "build", "drop", "break", "final", "outro"], "properties": {"intro": {"$ref": "#/$defs/positiveChoices"}, "verse": {"$ref": "#/$defs/positiveChoices"}, "build": {"$ref": "#/$defs/positiveChoices"}, "drop": {"$ref": "#/$defs/positiveChoices"}, "break": {"$ref": "#/$defs/positiveChoices"}, "final": {"$ref": "#/$defs/positiveChoices"}, "outro": {"$ref": "#/$defs/positiveChoices"}}},
    "rolePriority": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}},
    "sectionPriorityMap": {"type": "object", "additionalProperties": false, "required": ["intro", "verse", "build", "drop", "break", "final", "outro"], "properties": {"intro": {"$ref": "#/$defs/rolePriority"}, "verse": {"$ref": "#/$defs/rolePriority"}, "build": {"$ref": "#/$defs/rolePriority"}, "drop": {"$ref": "#/$defs/rolePriority"}, "break": {"$ref": "#/$defs/rolePriority"}, "final": {"$ref": "#/$defs/rolePriority"}, "outro": {"$ref": "#/$defs/rolePriority"}}},
    "sectionVelocityMap": {"type": "object", "additionalProperties": false, "required": ["intro", "verse", "build", "drop", "break", "final", "outro"], "properties": {"intro": {"$ref": "#/$defs/qChoices"}, "verse": {"$ref": "#/$defs/qChoices"}, "build": {"$ref": "#/$defs/qChoices"}, "drop": {"$ref": "#/$defs/qChoices"}, "break": {"$ref": "#/$defs/qChoices"}, "final": {"$ref": "#/$defs/qChoices"}, "outro": {"$ref": "#/$defs/qChoices"}}}
  }
}
