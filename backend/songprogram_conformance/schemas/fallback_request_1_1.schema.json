{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/fallback_request_1_1.schema.json",
  "title": "CPS DeterministicFallbackRequest v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_version", "root_seed", "action_coordinate", "action_id",
    "run_manifest_hash", "planner_manifest_hash", "fallback_manifest",
    "fallback_manifest_hash", "mutation_choice_catalog_hash", "program", "program_hash",
    "locked_roots", "diagnostic_codes", "requested_mutation_count", "request_hash"
  ],
  "properties": {
    "schema": {"const": "cps.fallback-request"},
    "schema_version": {"const": "1.1.0"},
    "root_seed": {"$ref": "#/$defs/u64"},
    "action_coordinate": {"$ref": "#/$defs/actionCoordinate"},
    "action_id": {"type": "string", "pattern": "^act_[a-z2-7]{26}$"},
    "run_manifest_hash": {"$ref": "#/$defs/sha"},
    "planner_manifest_hash": {"oneOf": [{"$ref": "#/$defs/sha"}, {"type": "null"}]},
    "fallback_manifest": {"$ref": "fallback_manifest_1_1.schema.json"},
    "fallback_manifest_hash": {"$ref": "#/$defs/sha"},
    "mutation_choice_catalog_hash": {"$ref": "#/$defs/sha"},
    "program": {"$ref": "song_program_0_1.schema.json"},
    "program_hash": {"$ref": "#/$defs/sha"},
    "locked_roots": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/root"}},
    "diagnostic_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,79}$"}},
    "requested_mutation_count": {"type": "integer", "minimum": 1, "maximum": 4},
    "request_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "root": {"$ref": "fallback_request.schema.json#/$defs/root"},
    "actionCoordinate": {
      "type": "object", "additionalProperties": false,
      "required": ["run_hash", "round", "phase_ordinal", "candidate_ordinal", "event_ordinal"],
      "properties": {
        "run_hash": {"$ref": "#/$defs/sha"}, "round": {"$ref": "#/$defs/u64"},
        "phase_ordinal": {"type": "integer", "minimum": 0, "maximum": 13},
        "candidate_ordinal": {"$ref": "#/$defs/u64"},
        "event_ordinal": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    }
  }
}
