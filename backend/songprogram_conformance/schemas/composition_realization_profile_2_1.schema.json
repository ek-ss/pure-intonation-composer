{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/composition_realization_profile_2_1.schema.json",
  "title": "Composition Realization Profile 2.1 — role masks and active density",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "schema_version", "profile_id", "choice_algorithm", "role_masks_by_function", "density_policy_by_role", "texture_modes_by_function", "profile_hash"],
  "properties": {
    "schema": {"const": "cps.composition-realization-profile"},
    "schema_version": {"const": "2.1.0"},
    "profile_id": {"type": "string", "minLength": 1},
    "choice_algorithm": {"const": "seed-domain-sha256-weighted/v1"},
    "role_masks_by_function": {
      "type": "object", "additionalProperties": false,
      "required": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"],
      "properties": {
        "opening": {"$ref": "#/$defs/masks"}, "statement": {"$ref": "#/$defs/masks"},
        "preparation": {"$ref": "#/$defs/masks"}, "arrival": {"$ref": "#/$defs/masks"},
        "contrast": {"$ref": "#/$defs/masks"}, "return": {"$ref": "#/$defs/masks"},
        "closure": {"$ref": "#/$defs/masks"}
      }
    },
    "density_policy_by_role": {
      "type": "object", "additionalProperties": false,
      "required": ["drums", "bass", "harmony", "melody"],
      "properties": {
        "drums": {"$ref": "#/$defs/density"}, "bass": {"$ref": "#/$defs/density"},
        "harmony": {"$ref": "#/$defs/density"}, "melody": {"$ref": "#/$defs/density"}
      }
    },
    "texture_modes_by_function": {
      "type": "object", "additionalProperties": false,
      "required": ["opening", "statement", "preparation", "arrival", "contrast", "return", "closure"],
      "properties": {
        "opening": {"$ref": "#/$defs/textureModes"}, "statement": {"$ref": "#/$defs/textureModes"},
        "preparation": {"$ref": "#/$defs/textureModes"}, "arrival": {"$ref": "#/$defs/textureModes"},
        "contrast": {"$ref": "#/$defs/textureModes"}, "return": {"$ref": "#/$defs/textureModes"},
        "closure": {"$ref": "#/$defs/textureModes"}
      }
    },
    "profile_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "role": {"enum": ["drums", "bass", "harmony", "melody", "texture"]},
    "mask": {"type": "object", "additionalProperties": false, "required": ["roles", "weight"], "properties": {"roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/role"}}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}}},
    "masks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mask"}},
    "density": {"type": "object", "additionalProperties": false, "required": ["minimum_events_per_bar", "maximum_events_per_bar", "candidate_positions_q", "mandatory_positions_q"], "properties": {"minimum_events_per_bar": {"type": "integer", "minimum": 0, "maximum": 32}, "maximum_events_per_bar": {"type": "integer", "minimum": 0, "maximum": 32}, "candidate_positions_q": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 9999}}, "mandatory_positions_q": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 9999}}}},
    "textureMode": {"enum": ["pad", "noise_riser", "fx_impact", "transition_tail", "arp", "vocal_chop", "counterline", "pluck"]},
    "textureModes": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["mode", "weight"], "properties": {"mode": {"$ref": "#/$defs/textureMode"}, "weight": {"type": "integer", "minimum": 1, "maximum": 2147483647}}}}
  }
}
