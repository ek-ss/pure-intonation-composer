{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/calibration_acceptance_policy.schema.json",
  "title": "CalibrationAcceptancePolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "algorithm",
    "root_seed",
    "statistic_operator_hash",
    "evaluation_epoch_day",
    "replicate_count",
    "strata",
    "lower_rank_numerator",
    "lower_rank_denominator",
    "upper_rank_numerator",
    "upper_rank_denominator",
    "minimum_listeners",
    "minimum_judgments",
    "minimum_within_rater_q",
    "minimum_inter_rater_q",
    "minimum_precision_lower_q",
    "maximum_false_accept_upper_q",
    "policy_hash"
  ],
  "properties": {
    "schema": {
      "const": "cps.calibration-acceptance-policy"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "deterministic-stratified-bootstrap-q/v1"
    },
    "root_seed": {
      "$ref": "#/$defs/u64"
    },
    "statistic_operator_hash": {
      "$ref": "#/$defs/sha"
    },
    "evaluation_epoch_day": {
      "$ref": "#/$defs/u64"
    },
    "replicate_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000
    },
    "strata": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
      }
    },
    "lower_rank_numerator": {
      "type": "integer",
      "minimum": 0
    },
    "lower_rank_denominator": {
      "type": "integer",
      "minimum": 1
    },
    "upper_rank_numerator": {
      "type": "integer",
      "minimum": 0
    },
    "upper_rank_denominator": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_listeners": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_judgments": {
      "type": "integer",
      "minimum": 1
    },
    "minimum_within_rater_q": {
      "$ref": "#/$defs/q"
    },
    "minimum_inter_rater_q": {
      "$ref": "#/$defs/q"
    },
    "minimum_precision_lower_q": {
      "$ref": "#/$defs/q"
    },
    "maximum_false_accept_upper_q": {
      "$ref": "#/$defs/q"
    },
    "policy_hash": {
      "$ref": "#/$defs/sha"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "q": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    }
  }
}
