{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://cps.local/schemas/perceptual_genre_result.schema.json","title":"PIL PerceptualGenreResult v1","type":"object","additionalProperties":false,"required":["schema","schema_version","genre_id","model_ordinal","model_hash","feature_record_hash","harmonic_detail_q","typicality_q","idiomaticity_q","cliche_dependence_q","novelty_q","missing_groups","result_hash"],"properties":{"schema":{"const":"cps.perceptual-genre-result"},"schema_version":{"const":"1.0.0"},"genre_id":{"type":"string","pattern":"^[a-z][a-z0-9_.-]{0,127}$"},"model_ordinal":{"type":"integer","minimum":0,"maximum":63},"model_hash":{"$ref":"#/$defs/sha"},"feature_record_hash":{"$ref":"#/$defs/sha"},"harmonic_detail_q":{"type":"object","additionalProperties":false,"required":["chord_vocabulary","progression","function","voice_leading","harmonic_rhythm"],"properties":{"chord_vocabulary":{"$ref":"#/$defs/q"},"progression":{"$ref":"#/$defs/q"},"function":{"$ref":"#/$defs/q"},"voice_leading":{"$ref":"#/$defs/q"},"harmonic_rhythm":{"$ref":"#/$defs/q"}}},"typicality_q":{"type":"integer","minimum":0,"maximum":10000},"idiomaticity_q":{"type":"integer","minimum":0,"maximum":10000},"cliche_dependence_q":{"type":"integer","minimum":0,"maximum":10000},"novelty_q":{"type":"integer","minimum":0,"maximum":10000},"missing_groups":{"type":"array","prefixItems":[{"const":"melody"},{"const":"rhythm"},{"const":"form"},{"const":"instrumentation"},{"const":"production"}],"items":false,"minItems":5,"maxItems":5},"result_hash":{"$ref":"#/$defs/sha"}},"$defs":{"sha":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"q":{"type":["integer","null"],"minimum":0,"maximum":10000}}}
