{
  "$schema":"https://json-schema.org/draft/2020-12/schema", "$id":"https://cps.local/schemas/charge_receipt.schema.json", "title":"CPS ChargeReceipt v1",
  "type":"object","additionalProperties":false,"required":["schema","schema_version","budget_profile_digest","input_hash","status","usage","children","opcode_stream_hash"],
