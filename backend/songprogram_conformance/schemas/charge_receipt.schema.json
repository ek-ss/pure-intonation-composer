  "$defs":{"sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},"counterValue":{"type":"integer","minimum":0,"maximum":18446744073709551615},"counters":{"type":"object","additionalProperties":false,"required":["structural_items","placed_domain_points","exact_arithmetic_units","numeric_eval_units","chord_search_nodes","pair_relations","ordering_units","validation_items","emitted_events","total_logical_units"],"properties":{"structural_items":{"$ref":"#/$defs/counterValue"},"placed_domain_points":{"$ref":"#/$defs/counterValue"},"exact_arithmetic_units":{"$ref":"#/$defs/counterValue"},"numeric_eval_units":{"$ref":"#/$defs/counterValue"},"chord_search_nodes":{"$ref":"#/$defs/counterValue"},"pair_relations":{"$ref":"#/$defs/counterValue"},"ordering_units":{"$ref":"#/$defs/counterValue"},"validation_items":{"$ref":"#/$defs/counterValue"},"emitted_events":{"$ref":"#/$defs/counterValue"},"total_logical_units":{"$ref":"#/$defs/counterValue"}}},"child":{"type":"object","additionalProperties":false,"required":["query_id","usage","opcode_stream_hash"],"properties":{"query_id":{"type":"string","pattern":"^[a-z][a-z0-9_-]{0,63}$"},"usage":{"$ref":"#/$defs/counters"},"opcode_stream_hash":{"$ref":"#/$defs/sha256"}}}}
