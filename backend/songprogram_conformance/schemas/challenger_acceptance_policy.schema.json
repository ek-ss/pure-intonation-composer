{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/challenger_acceptance_policy.schema.json",
  "title": "CPS ChallengerAcceptancePolicy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "genre_intent_hash",
    "evaluation_manifest_hash",
    "required_hard_checks",
    "metrics",
    "pareto_rule",
    "tie_rule"
  ],
  "properties": {
    "schema": {
      "const": "cps.challenger-acceptance-policy"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "genre_intent_hash": {
      "$ref": "#/$defs/sha"
    },
    "evaluation_manifest_hash": {
      "$ref": "#/$defs/sha"
    },
    "required_hard_checks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}$"
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/metric"
      }
    },
    "pareto_rule": {
      "const": "all-within-margin-one-beyond/v1"
    },
    "tie_rule": {
      "const": "margin-adjusted-metric-tuple-then-program-hash/v1"
    }
  },
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "genre_intent_path",
        "direction",
        "margin_q",
        "ordinal",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "genre_intent_path": {
          "type": "string",
          "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$"
        },
        "direction": {
          "enum": [
            "maximize",
            "minimize"
          ]
        },
        "margin_q": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "source": { "$ref": "#/$defs/source" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_kind", "schema_hash", "json_pointer"],
      "properties": {
        "artifact_kind": { "enum": ["evaluation_report", "compile_report", "fingerprint_record"] },
        "schema_hash": { "$ref": "#/$defs/sha" },
        "json_pointer": { "type": "string", "pattern": "^/(?:[^~/]|~0|~1)+(?:/(?:[^~/]|~0|~1)+)*$" }
      }
    }
  }
}
