{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/gen0_cohort_gate_fixture_suite_index.schema.json",
  "title": "CPS GEN0 CohortGate FixtureSuiteIndex v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "contract", "generator_identity", "schemas", "schema_registry", "cas_index", "matrix_receipt", "cases", "coverage", "suite_hash"],
  "properties": {
    "schema": {"const": "cps.gen0-cohort-gate-fixture-suite-index"},
    "schema_version": {"const": "1.0.0"},
    "contract": {"const": "cps-gen0-cohort-gate/v1"},
    "generator_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "schemas": {
      "type": "object", "additionalProperties": false,
      "required": ["manifest", "candidate_record", "candidate_ledger", "report", "cas_index", "matrix_receipt", "suite_index"],
      "properties": {"manifest": {"$ref": "#/$defs/file"}, "candidate_record": {"$ref": "#/$defs/file"}, "candidate_ledger": {"$ref": "#/$defs/file"}, "report": {"$ref": "#/$defs/file"}, "cas_index": {"$ref": "#/$defs/file"}, "matrix_receipt": {"$ref": "#/$defs/file"}, "suite_index": {"$ref": "#/$defs/file"}}
    },
    "schema_registry": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/schemaEntry"}},
    "cas_index": {"$ref": "#/$defs/file"},
    "matrix_receipt": {"$ref": "#/$defs/file"},
    "cases": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"oneOf": [{"$ref": "#/$defs/success"}, {"$ref": "#/$defs/failure"}]}},
    "coverage": {"type": "array", "minItems": 34, "maxItems": 34, "uniqueItems": true, "items": {"$ref": "#/$defs/coverage"}},
    "suite_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "file": {"type": "object", "additionalProperties": false, "required": ["path", "raw_sha256"], "properties": {"path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha"}}},
    "schemaEntry": {"type": "object", "additionalProperties": false, "required": ["schema_id", "path", "raw_sha256", "artifact_kinds", "identity_rules"], "properties": {"schema_id": {"type": "string", "pattern": "^https://cps\\.local/schemas/[A-Za-z0-9_.-]+\\.schema\\.json$"}, "path": {"$ref": "#/$defs/path"}, "raw_sha256": {"$ref": "#/$defs/sha"}, "artifact_kinds": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/artifactKind"}}, "identity_rules": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/identityRule"}}}},
    "artifactKind": {"enum": ["sampler_manifest", "structural_lowering_manifest", "production_lowering_manifest", "compiler_manifest", "evaluation_manifest", "descriptor_spec", "fingerprint_spec", "qd_manifest", "near_duplicate_calibration_decision", "sampler_request", "sampler_result", "production_request", "production_result", "program", "compile_report", "project", "evaluation_report", "fingerprint_record", "fingerprint_component", "near_duplicate_decision"]},
    "identityRule": {"enum": ["sampler-manifest-v1.1", "structural-lowering-manifest-v1", "production-lowering-manifest-v1", "compiler-manifest-v1.1", "evaluation-manifest-v1.1", "descriptor-spec-v1", "fingerprint-spec-v1", "qd-manifest-v1", "near-duplicate-calibration-decision-v1", "structural-sampler-result-v1.1", "broad-prior-production-result-v1.1", "song-program-v0.1", "generic-cps-artifact-v1", "arrangement-project-v1.2", "fingerprint-component-v1"]},
    "base": {"type": "object", "additionalProperties": {}, "required": ["case_id", "kind", "manifest", "records", "coverage"], "properties": {"case_id": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{0,127}$"}, "kind": {"type": "string"}, "manifest": {"$ref": "#/$defs/file"}, "records": {"$ref": "#/$defs/file"}, "coverage": {"type": "array", "minItems": 1, "maxItems": 34, "uniqueItems": true, "items": {"$ref": "#/$defs/coverage"}}}},
    "success": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["case_id", "kind", "manifest", "records", "coverage", "expected_report"], "properties": {"case_id": {"type": "string"}, "kind": {"const": "success"}, "manifest": {"$ref": "#/$defs/file"}, "records": {"$ref": "#/$defs/file"}, "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}, "expected_report": {"$ref": "#/$defs/file"}}}]},
    "failure": {"allOf": [{"$ref": "#/$defs/base"}, {"type": "object", "additionalProperties": false, "required": ["case_id", "kind", "manifest", "records", "coverage", "input_report", "expected_code"], "properties": {"case_id": {"type": "string"}, "kind": {"const": "failure"}, "manifest": {"$ref": "#/$defs/file"}, "records": {"$ref": "#/$defs/file"}, "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}, "input_report": {"$ref": "#/$defs/file"}, "expected_code": {"$ref": "#/$defs/error"}}}]},
    "coverage": {"enum": ["golden.success", "policy.near_audit_only", "policy.near_enforced", "boundary.compile.9490_fail", "boundary.compile.9500_pass", "boundary.initial_viability.6990_fail", "boundary.initial_viability.7000_pass", "boundary.planner_viability.7990_fail", "boundary.planner_viability.8000_pass", "boundary.exact_duplicate.90_pass", "boundary.exact_duplicate.100_fail", "boundary.near_duplicate.990_pass", "boundary.near_duplicate.1000_fail", "boundary.transformed_recall.7990_fail", "boundary.transformed_recall.8000_pass", "boundary.mode.3500_pass", "boundary.mode.3510_fail", "failure.report_schema", "failure.manifest_schema", "failure.manifest_hash", "failure.record_count", "failure.record_order", "failure.record_hash", "failure.coordinate", "failure.artifact_binding", "failure.stage_precedence", "failure.duplicate_classification", "failure.mode_key", "failure.ledger_hash", "failure.aggregate", "failure.gate_result", "failure.report_hash", "process.pythonhashseed_0_1_7_42", "parallel.workers_1_2_4_8"]},
    "error": {"enum": ["COHORT_REPORT_SCHEMA_INVALID", "COHORT_MANIFEST_INVALID", "COHORT_MANIFEST_HASH_MISMATCH", "COHORT_RECORD_COUNT_MISMATCH", "COHORT_RECORD_ORDER_INVALID", "COHORT_RECORD_HASH_MISMATCH", "COHORT_COORDINATE_MISMATCH", "COHORT_ARTIFACT_BINDING_MISMATCH", "COHORT_STAGE_PRECEDENCE_INVALID", "COHORT_DUPLICATE_CLASSIFICATION_INVALID", "COHORT_MODE_KEY_INVALID", "COHORT_LEDGER_HASH_MISMATCH", "COHORT_AGGREGATE_MISMATCH", "COHORT_GATE_RESULT_MISMATCH", "COHORT_REPORT_HASH_MISMATCH"]}
  }
}
