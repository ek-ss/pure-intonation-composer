{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/compiler_manifest.schema.json",
  "title": "CPS CompilerManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "build_id",
    "song_program_schema_versions",
    "project_schema_version",
    "numeric_contract",
    "resolver",
    "budget_profile",
    "instrument_catalog_digest",
    "dependency_lock_digest",
    "prng_contract"
  ],
  "properties": {
    "schema": {
      "const": "cps.compiler-manifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "song_program_schema_versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
      }
    },
    "project_schema_version": {
      "const": "1.2.0"
    },
    "numeric_contract": {
      "const": "cps-numeric/decimal-log2-rhe-v1"
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_id",
        "algorithm",
        "profile_hash",
        "search_completeness"
      ],
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "algorithm": {
          "enum": [
            "sp0-exhaustive-joint/v1",
            "sp0-joint-bnb/v1"
          ]
        },
        "profile_hash": {
          "$ref": "#/$defs/sha256"
        },
        "search_completeness": {
          "const": "exact"
        }
      }
    },
    "budget_profile": {
      "$ref": "#/$defs/budgetProfile"
    },
    "instrument_catalog_digest": {
      "$ref": "#/$defs/sha256"
    },
    "dependency_lock_digest": {
      "$ref": "#/$defs/sha256"
    },
    "prng_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structural_items",
        "placed_domain_points",
        "exact_arithmetic_units",
        "numeric_eval_units",
        "chord_search_nodes",
        "pair_relations",
        "ordering_units",
        "validation_items",
        "emitted_events",
        "total_logical_units"
      ],
      "properties": {
        "structural_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "placed_domain_points": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "exact_arithmetic_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "numeric_eval_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "chord_search_nodes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "pair_relations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "ordering_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "validation_items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "emitted_events": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "progression_states": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "progression_edges": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "total_logical_units": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "budgetProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "root_ceilings",
        "child_ceilings",
        "domain_limits",
        "shape_limits"
      ],
      "properties": {
        "id": {
          "enum": [
            "sp0-small-exact-v1",
            "gen0-progression-exact-v1"
          ]
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "root_ceilings": {
          "$ref": "#/$defs/counters"
        },
        "child_ceilings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chord_search_nodes",
            "pair_relations",
            "numeric_eval_units",
            "maximum_depth"
          ],
          "properties": {
            "chord_search_nodes": {
              "type": "integer",
              "minimum": 0
            },
            "pair_relations": {
              "type": "integer",
              "minimum": 0
            },
        "numeric_eval_units": {
          "type": "integer",
          "minimum": 0
        },
        "exact_arithmetic_units": {
          "type": "integer",
          "minimum": 0
        },
        "ordering_units": {
          "type": "integer",
          "minimum": 0
        },
        "progression_states": {
              "type": "integer",
              "minimum": 0
            },
            "progression_edges": {
              "type": "integer",
              "minimum": 0
            },
            "maximum_depth": {
              "const": 1
            }
          }
        },
        "domain_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dimensions",
            "coordinate_cardinality",
            "axis_width",
            "register_width",
            "placed_cardinality",
            "arithmetic_result_bits"
          ],
          "properties": {
            "dimensions": {
              "const": 2
            },
            "coordinate_cardinality": {
              "const": 1024
            },
            "axis_width": {
              "const": 7
            },
            "register_width": {
              "const": 8
            },
            "placed_cardinality": {
              "const": 4096
            },
            "arithmetic_result_bits": {
              "const": 4096
            }
          }
        },
        "shape_limits": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voices",
            "intents",
            "rhythm_steps_per_material",
            "repeats",
            "sections",
            "bars",
            "events"
          ],
          "properties": {
            "voices": {
              "const": 4
            },
            "intents": {
              "const": 8
            },
            "rhythm_steps_per_material": {
              "const": 64
            },
            "repeats": {
              "const": 8
            },
            "sections": {
              "const": 4
            },
            "bars": {
              "const": 8
            },
            "events": {
              "const": 2048
            },
            "progression_occurrences": {
              "const": 512
            },
            "progression_candidates_per_occurrence": {
              "const": 24
            }
          }
        }
      }
    }
  }
}
