{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/compiler_manifest_1_1.schema.json",
  "title": "CPS GEN0-B CompilerManifest 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "build_id",
    "song_program_schema_versions",
    "project_schema_version",
    "numeric_contract",
    "resolver",
    "progression_resolver",
    "budget_profile",
    "instrument_catalog_digest",
    "dependency_lock_digest",
    "prng_contract"
  ],
  "properties": {
    "schema": {
      "const": "cps.compiler-manifest"
    },
    "schema_version": {
      "const": "1.1.0"
    },
    "build_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "song_program_schema_versions": {
      "type": "array",
      "prefixItems": [
        {
          "const": "0.1.0"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "project_schema_version": {
      "const": "1.2.0"
    },
    "numeric_contract": {
      "const": "cps-numeric/decimal-log2-rhe-v1"
    },
    "resolver": {
      "$ref": "#/$defs/resolver"
    },
    "progression_resolver": {
      "$ref": "#/$defs/progression"
    },
    "budget_profile": {
      "allOf": [
        {"$ref": "compiler_manifest.schema.json#/$defs/budgetProfile"},
        {
          "additionalProperties": {},
          "properties": {
            "id": {"const": "gen0-progression-exact-v1"},
            "root_ceilings": {"additionalProperties": {}, "required": ["progression_states", "progression_edges"]},
            "child_ceilings": {
              "additionalProperties": {},
              "required": ["chord_search_nodes", "pair_relations", "numeric_eval_units", "exact_arithmetic_units", "ordering_units", "progression_states", "progression_edges", "maximum_depth"],
              "properties": {
                "exact_arithmetic_units": {"const": 500000},
                "ordering_units": {"const": 500000},
                "progression_states": {"const": 12288},
                "progression_edges": {"const": 294336}
              }
            },
            "shape_limits": {"additionalProperties": {}, "required": ["progression_occurrences", "progression_candidates_per_occurrence"]}
          }
        }
      ]
    },
    "instrument_catalog_digest": {
      "$ref": "#/$defs/sha256"
    },
    "dependency_lock_digest": {
      "$ref": "#/$defs/sha256"
    },
    "prng_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "version"
      ],
      "properties": {
        "algorithm": {
          "const": "path-addressed-sha256-counter"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "u64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_id",
        "algorithm",
        "profile_hash",
        "search_completeness"
      ],
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "algorithm": {
          "enum": [
            "sp0-exhaustive-joint/v1",
            "sp0-joint-bnb/v1"
          ]
        },
        "profile_hash": {
          "$ref": "#/$defs/sha256"
        },
        "search_completeness": {
          "const": "exact"
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_id",
        "algorithm",
        "profile_hash",
        "search_completeness",
        "candidates_per_intent",
        "maximum_voice_motion_millicents",
        "crossing_policy"
      ],
      "properties": {
        "build_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "algorithm": {
          "const": "gen0-progression-exact/v1"
        },
        "profile_hash": {
          "$ref": "#/$defs/sha256"
        },
        "search_completeness": {
          "const": "exact"
        },
        "candidates_per_intent": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "maximum_voice_motion_millicents": {
          "$ref": "#/$defs/u64"
        },
        "crossing_policy": {
          "enum": [
            "allow",
            "forbid"
          ]
        }
      }
    }
  }
}
