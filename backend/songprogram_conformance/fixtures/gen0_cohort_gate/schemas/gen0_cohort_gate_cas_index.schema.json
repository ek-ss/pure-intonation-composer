{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/gen0_cohort_gate_cas_index.schema.json",
  "title": "CPS GEN0 CohortGate CAS Index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "entries", "index_hash"],
  "properties": {
    "schema": {"const": "cps.gen0-cohort-gate-cas-index"},
    "schema_version": {"const": "1.0.0"},
    "entries": {"type": "array", "maxItems": 16000, "items": {"$ref": "#/$defs/entry"}},
    "index_hash": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"},
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_hash", "artifact_kind", "schema_hash", "path", "raw_sha256"],
      "properties": {
        "artifact_hash": {"$ref": "#/$defs/sha"},
        "artifact_kind": {"enum": ["sampler_manifest", "structural_lowering_manifest", "production_lowering_manifest", "compiler_manifest", "evaluation_manifest", "descriptor_spec", "fingerprint_spec", "qd_manifest", "near_duplicate_calibration_decision", "sampler_request", "sampler_result", "production_request", "production_result", "program", "compile_report", "project", "evaluation_report", "fingerprint_record", "fingerprint_component", "near_duplicate_decision"]},
        "schema_hash": {"$ref": "#/$defs/sha"},
        "path": {"$ref": "#/$defs/path"},
        "raw_sha256": {"$ref": "#/$defs/sha"}
      }
    }
  }
}
