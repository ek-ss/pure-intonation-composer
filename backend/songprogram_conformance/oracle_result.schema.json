{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cps.local/schemas/sp0-oracle-result-v1.json",
  "title": "SP0 OracleResult v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "search_completeness", "canonical_steps", "vectors", "equave_exponents", "exact_ratios", "pair_errors_millicents", "pair_max_millicents", "pair_rms_millicents", "complexity_score", "score_prefix", "examined_assignments"],
  "properties": {
    "schema": {"const": "cps.sp0-oracle-result/v1"},
    "search_completeness": {"const": "exact"},
    "canonical_steps": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "integer"}},
    "vectors": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"type": "integer"}}},
    "equave_exponents": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "integer"}},
    "exact_ratios": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"type": "string"}},
    "pair_errors_millicents": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "integer"}},
    "pair_max_millicents": {"type": "integer", "minimum": 0},
    "pair_rms_millicents": {"type": "integer", "minimum": 0},
    "complexity_score": {"type": "integer", "minimum": 0},
    "score_prefix": {"type": "array", "prefixItems": [{"type": "integer"}, {"type": "integer"}, {"type": "integer"}], "items": false},
    "examined_assignments": {"type": "integer", "minimum": 1}
  }
}
